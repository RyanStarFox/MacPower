    "settings.permissions.bluetooth.reason.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why MacPower uses Bluetooth"
          }
        },
        "zh-Hans": {
