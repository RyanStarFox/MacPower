          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em uma cor para editá-la com a mesma barra da barra de menus. Para mudar a cor de um anel, escolha-a ao lado dele acima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un colore per modificarlo con la stessa barra della barra dei menu. Per cambiare il colore di un anello, sceglilo accanto a quell’anello qui sopra."
          }
        },
