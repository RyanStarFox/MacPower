    "tutorial.rings.rows": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "开关决定这一项出不出现。按住一行上下拖动就能调整顺序。点「添加换行」，再把这条换行拖到要分开的位置，面板就从那里另起一行。蓝牙设备也在这份列表里。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "開關決定這一項出不出現。按住一行上下拖動就能調整順序。點「加入換行」，再把這條換行拖到要分開的位置，面板就從那裡另起一行。藍牙裝置也在這份列表裡。" } },
        "en": { "stringUnit": { "state": "translated", "value": "The switch shows or hides a ring. Drag a row up or down to change the order. Tap Add a row break, then drag that break to where the panel should start a new row. Bluetooth devices sit in this same list." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Schalter blendet den Ring ein oder aus. Ziehe einen Eintrag nach oben oder unten, um die Reihenfolge zu ändern. Die Umbruch-Taste beginnt danach eine neue Zeile. Bluetooth-Geräte stehen in derselben Liste." } },
        "es": { "stringUnit": { "state": "translated", "value": "El interruptor muestra u oculta el anillo. Arrastra una fila hacia arriba o abajo para cambiar el orden. El botón de salto empieza una fila nueva después de ese elemento. Los dispositivos Bluetooth están en la misma lista." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’interrupteur affiche ou masque l’anneau. Fais glisser une ligne vers le haut ou le bas pour changer l’ordre. Le bouton de saut commence une nouvelle ligne après cet élément. Les appareils Bluetooth sont dans la même liste." } },
        "it": { "stringUnit": { "state": "translated", "value": "L’interruttore mostra o nasconde l’anello. Trascina una riga in alto o in basso per cambiare l’ordine. Il pulsante di a capo inizia una nuova riga dopo quella voce. I dispositivi Bluetooth stanno nella stessa lista." } },
        "ja": { "stringUnit": { "state": "translated", "value": "スイッチでリングの表示を切り替えます。行を上下にドラッグして順番を変えます。改行ボタンで、その項目のあとからパネルを改行します。Bluetooth 機器も同じリストに並びます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "스위치로 링을 켜거나 끕니다. 줄을 위아래로 끌어 순서를 바꿉니다. 줄바꿈 버튼으로 그 항목 다음부터 새 줄을 시작합니다. Bluetooth 기기도 같은 목록에 있습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O interruptor mostra ou oculta o anel. Arraste uma linha para cima ou para baixo para mudar a ordem. O botão de quebra começa uma nova linha depois desse item. Os dispositivos Bluetooth ficam na mesma lista." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Переключатель показывает или скрывает кольцо. Перетащите строку вверх или вниз, чтобы изменить порядок. Кнопка переноса начинает новую строку после этого пункта. Устройства Bluetooth стоят в том же списке." } }
      }
    },
    "tutorial.rings.bluetooth": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Verbinde die Kopfhörer zuerst unter Systemeinstellungen → Bluetooth. Tippe dann in der Ringliste auf „Gerät hinzufügen“ und wähle ein Gerät, dessen Akku das System meldet. Links, rechts und das Case können ein Ring sein oder getrennt bleiben." } },
        "en": { "stringUnit": { "state": "translated", "value": "Connect the headphones in System Settings → Bluetooth first. Then, in this ring list, tap Add a device and pick one whose battery the system can read. Left, right, and the case can share one ring or stay separate." } },
        "es": { "stringUnit": { "state": "translated", "value": "Conecta los auriculares en Ajustes del Sistema → Bluetooth. Después, en esta lista, pulsa Añadir un dispositivo y elige uno cuya batería lea el sistema. Izquierda, derecha y el estuche pueden ir en un anillo o por separado." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Connecte d’abord les écouteurs dans Réglages Système → Bluetooth. Puis, dans cette liste, touche Ajouter un appareil et choisis-en un dont le système lit la batterie. Gauche, droite et le boîtier peuvent partager un anneau ou rester séparés." } },
        "it": { "stringUnit": { "state": "translated", "value": "Collega prima le cuffie in Impostazioni di Sistema → Bluetooth. Poi, in questo elenco, tocca Aggiungi un dispositivo e scegline uno di cui il sistema legge la batteria. Sinistra, destra e la custodia possono stare in un anello o separati." } },
        "ja": { "stringUnit": { "state": "translated", "value": "まずシステム設定の Bluetooth でヘッドホンを接続します。この一覧で「機器を追加」を押し、システムが電池を読める機器を選びます。左、右、ケースは一つのリングにまとめても、分けても表示できます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "먼저 시스템 설정의 Bluetooth에서 헤드폰을 연결하세요. 이 목록에서 기기 추가를 누르고, 시스템에서 배터리를 읽는 기기를 고르면 됩니다. 왼쪽, 오른쪽, 케이스는 링 하나에 모으거나 나눠 둘 수 있습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Conecte os fones em Ajustes do Sistema → Bluetooth. Depois, nesta lista, toque em Adicionar um dispositivo e escolha um cuja bateria o sistema leia. Esquerdo, direito e o estojo podem ficar em um anel ou separados." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сначала подключите наушники в Системных настройках → Bluetooth. Затем в этом списке нажмите «Добавить устройство» и выберите то, чей заряд система читает. Левый, правый и футляр могут быть одним кольцом или отдельными." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "先在系统设置的「蓝牙」里连上耳机。然后在这份圆环列表里点「添加设备」，选中系统已经读到电量的那一副。左耳、右耳和盒子可以合成一个圆环，也可以分开。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "先在系統設定的「藍牙」裡連上耳機。然後在這份圓環列表裡點「加入裝置」，選中系統已經讀到電量的那一副。左耳、右耳和盒子可以合成一個圓環，也可以分開。" } }
      }
    },
    "settings.rings.bluetooth.connectHint": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Verbinde die Kopfhörer unter Systemeinstellungen → Bluetooth. Tippe dann auf „Gerät hinzufügen“ und wähle ein Gerät, dessen Akku das System meldet." } },
        "en": { "stringUnit": { "state": "translated", "value": "Connect the headphones in System Settings → Bluetooth, then tap Add a device and pick one whose battery the system can read." } },
        "es": { "stringUnit": { "state": "translated", "value": "Conecta los auriculares en Ajustes del Sistema → Bluetooth y pulsa Añadir un dispositivo para elegir uno cuya batería lea el sistema." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Connecte les écouteurs dans Réglages Système → Bluetooth, puis touche Ajouter un appareil et choisis-en un dont le système lit la batterie." } },
        "it": { "stringUnit": { "state": "translated", "value": "Collega le cuffie in Impostazioni di Sistema → Bluetooth, poi tocca Aggiungi un dispositivo e scegline uno di cui il sistema legge la batteria." } },
        "ja": { "stringUnit": { "state": "translated", "value": "システム設定の Bluetooth でヘッドホンを接続してから「機器を追加」を押し、電池を読める機器を選びます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "시스템 설정의 Bluetooth에서 헤드폰을 연결한 뒤 기기 추가를 눌러, 배터리를 읽는 기기를 고르세요." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Conecte os fones em Ajustes do Sistema → Bluetooth e toque em Adicionar um dispositivo para escolher um cuja bateria o sistema leia." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Подключите наушники в Системных настройках → Bluetooth, затем нажмите «Добавить устройство» и выберите то, чей заряд система читает." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "先在系统设置的「蓝牙」里连上耳机，再点「添加设备」，选择系统已经读到电量的设备。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "先在系統設定的「藍牙」裡連上耳機，再點「加入裝置」，選擇系統已經讀到電量的裝置。" } }
      }
    },
    "settings.rings.lineBreak": {
