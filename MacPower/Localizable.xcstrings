          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 제공 프리셋은 덮어쓸 수 없습니다. 다른 이름으로 저장하여 사용자 지정 사본을 만드세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préréglages intégrés ne peuvent pas être écrasés. Utilisez Enregistrer sous pour créer une copie personnalisée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingebaute Presets können nicht überschrieben werden. Speichern Sie unter einem neuen Namen eine eigene Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes integrados no se pueden sobrescribir. Usa Guardar como para crear una copia personalizada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinições integradas não podem ser substituídas. Use Salvar como para criar uma cópia personalizada."
