    "welcome.icon.title": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Menüleistensymbol einschalten" } },
        "en": { "stringUnit": { "state": "translated", "value": "Turn on the menu bar icon" } },
        "es": { "stringUnit": { "state": "translated", "value": "Activar el icono de la barra de menús" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Activer l’icône de la barre des menus" } },
        "it": { "stringUnit": { "state": "translated", "value": "Attiva l’icona nella barra dei menu" } },
        "ja": { "stringUnit": { "state": "translated", "value": "メニューバーのアイコンをオンにする" } },
        "ko": { "stringUnit": { "state": "translated", "value": "메뉴 막대 아이콘 켜기" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Ativar o ícone da barra de menus" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Включите значок в строке меню" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开菜单栏图标" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "打開選單列圖示" } }
      }
    },
    "welcome.icon.body": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Öffne Systemeinstellungen → Menüleiste und schalte MacPower unter „In Menüleiste erlauben“ ein. Ist der Schalter aus, bleibt das Symbol verborgen. Schalte dort auch den Systemeintrag „Batterie“ aus, damit in der Menüleiste nur MacPower steht und nicht zwei Batteriesymbole." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open System Settings → Menu Bar, and switch on MacPower under “Allow in the Menu Bar”. While that switch is off, the icon stays hidden. On the same page, turn off the system Battery item so the menu bar keeps MacPower and does not show two battery icons." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre Ajustes del Sistema → Barra de menús y activa MacPower en «Permitir en la barra de menús». Si está desactivado, el icono no aparece. En la misma página, desactiva la «Batería» del sistema para que la barra de menús deje solo MacPower y no muestre dos iconos de batería." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvrez Réglages Système → Barre des menus, puis activez MacPower sous « Autoriser dans la barre des menus ». Si l’interrupteur est coupé, l’icône reste cachée. Sur la même page, désactivez la « Batterie » du système pour ne garder que MacPower et éviter deux icônes de batterie." } },
        "it": { "stringUnit": { "state": "translated", "value": "Apri Impostazioni di Sistema → Barra dei menu e attiva MacPower in «Consenti nella barra dei menu». Se l’interruttore è spento, l’icona non compare. Nella stessa pagina disattiva «Batteria» di sistema, così resta solo MacPower e non compaiono due icone della batteria." } },
        "ja": { "stringUnit": { "state": "translated", "value": "「システム設定」→「メニューバー」を開き、「メニューバーに追加することを許可」で MacPower をオンにしてください。オフのあいだ、アイコンは表示されません。同じページでシステムの「バッテリー」もオフにし、メニューバーには MacPower だけを残して、電池アイコンが二つ並ばないようにしてください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "시스템 설정 → 메뉴 막대에서 «메뉴 막대에서 허용»의 MacPower를 켜세요. 꺼져 있으면 아이콘이 나타나지 않습니다. 같은 페이지에서 시스템 «배터리»도 끄고, 메뉴 막대에는 MacPower만 남겨 배터리 아이콘이 두 개 나오지 않게 하세요." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Abra Ajustes do Sistema → Barra de Menus e ative o MacPower em “Permitir na Barra de Menus”. Com o interruptor desligado, o ícone não aparece. Na mesma página, desative a «Bateria» do sistema para a barra de menus ficar só com o MacPower e não mostrar dois ícones de bateria." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте «Системные настройки» → «Строка меню» и включите MacPower в разделе «Разрешить в строке меню». Пока переключатель выключен, значка нет. На той же странице выключите системный пункт «Батарея», чтобы в строке меню остался только MacPower и не было двух значков батареи." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开「系统设置 → 菜单栏」，在「允许在菜单栏显示」里打开 MacPower。这一项关掉时，图标不会出现。同时关掉系统自带的「电池」，菜单栏里只留 MacPower，避免两个电池图标叠在一起。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "打開「系統設定 → 選單列」，在「在選單列中允許」裡打開 MacPower。這一項關掉時，圖示不會出現。同時關掉系統自帶的「電池」，選單列裡只留 MacPower，避免兩個電池圖示疊在一起。" } }
      }
    },
    "welcome.icon.button": {
