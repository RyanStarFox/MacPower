    "settings.rings.scale.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed and temperature have no upper limit, but a ring has only one turn, so choose the value that fills half of it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "速度和温度没有上限，圆环却只有一圈，所以要指定「走到半圈」时对应的数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "速度和溫度沒有上限，圓環卻只有一圈，所以要指定「走到半圈」時對應的數值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速度や温度には上限がありませんが、リングは1周しかないので、半分になる値を指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속도와 온도에는 상한이 없지만 링은 한 바퀴뿐이라, 절반이 되는 값을 정합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse et la température n’ont pas de limite, mais un anneau ne fait qu’un tour : choisissez la valeur qui le remplit à moitié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschwindigkeit und Temperatur haben keine Obergrenze, ein Ring aber nur eine Runde. Wähle daher den Wert für einen halben Ring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocidad y la temperatura no tienen límite, pero un anillo solo da una vuelta: elige el valor que llena la mitad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidade e temperatura não têm limite, mas o anel só dá uma volta: escolha o valor que preenche metade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocità e temperatura non hanno limite, ma un anello ha un solo giro: scegli il valore che ne riempie metà."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У скорости и температуры нет предела, а у кольца лишь один оборот, поэтому задайте значение для половины кольца."
          }
        }
      }
    },
