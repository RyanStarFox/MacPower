    "welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower sitzt in der Menüleiste, nicht im Dock. Schalte das Symbol ein, danach geht alles von dort aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower lives in the menu bar, not the Dock. Turn the icon on, then everything starts from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower vive en la barra de menús, no en el Dock. Activa el icono y, a partir de ahí, todo empieza en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower reste dans la barre des menus, pas dans le Dock. Activez l’icône, puis tout se passe depuis là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower sta nella barra dei menu, non nel Dock. Attiva l’icona: da lì si fa tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower は Dock ではなくメニューバーにあります。アイコンをオンにすれば、そこからすべて操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower는 Dock이 아니라 메뉴 막대에 있습니다. 아이콘을 켜 두면 이후에는 거기서 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MacPower fica na barra de menus, não no Dock. Ative o ícone e, depois disso, tudo começa por ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower живёт в строке меню, а не в Dock. Включите значок — дальше всё начинается оттуда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower 待在菜单栏里，不会出现在程序坞。先把图标打开，以后就从这里进出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower 待在選單列裡，不會出現在程式塢。先把圖示打開，之後就從這裡進出。"
          }
        }
      }
    },
