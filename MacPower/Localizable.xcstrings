          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresses de votre réseau local, comme 192.168.x.x."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen im lokalen Netzwerk, etwa 192.168.x.x."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Direcciones de tu red local, como 192.168.x.x."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereços da sua rede local, como 192.168.x.x."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzi della rete locale, come 192.168.x.x."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса в локальной сети, например 192.168.x.x."
          }
        }
      }
    },
    "settings.localIP.scope.public.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address the internet sees. Looked up online; shows “Failed” when it can’t be found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "互联网上看到的你的地址，需要联网查询；查不到时显示「获取失败」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網際網路上看到的你的位址，需要連網查詢；查不到時顯示「取得失敗」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットから見えるアドレス。オンラインで調べます。取得できないときは「取得失敗」と表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷에서 보이는 주소입니다. 온라인으로 조회하며, 찾지 못하면 ‘가져오기 실패’로 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse vue depuis Internet. Recherchée en ligne ; affiche « Échec » si elle est introuvable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse, die das Internet sieht. Wird online abgefragt; zeigt „Fehlgeschlagen“, wenn sie nicht gefunden wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección que ve internet. Se consulta en línea; muestra «Error» si no se encuentra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço visto pela internet. Consultado on-line; mostra “Falhou” quando não é encontrado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo visto da internet. Viene cercato online; se non si trova mostra «Non riuscito»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес, который видит интернет. Запрашивается онлайн; если не найден, показывается «Ошибка»."
          }
        }
      }
    },
    "settings.localIP.scope.loopback.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address this Mac uses for itself, usually 127.0.0.1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 自己用的地址，通常是 127.0.0.1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 自己用的位址，通常是 127.0.0.1。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac が自分自身に使うアドレス。通常は 127.0.0.1。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac이 자기 자신에게 쓰는 주소로, 보통 127.0.0.1입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse que ce Mac utilise pour lui-même, en général 127.0.0.1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse, die dieser Mac für sich selbst nutzt, meist 127.0.0.1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección que este Mac usa para sí mismo, normalmente 127.0.0.1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço que este Mac usa para si mesmo, geralmente 127.0.0.1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo che questo Mac usa per sé stesso, di solito 127.0.0.1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес, который этот Mac использует сам для себя, обычно 127.0.0.1."
          }
        }
      }
    },
    "settings.localIP.scope.linkLocal.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Addresses that only work on the same network segment, starting with 169.254 or fe80."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在同一段网络里有效的地址，以 169.254 或 fe80 开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在同一段網路裡有效的位址，以 169.254 或 fe80 開頭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じネットワーク区間でのみ有効なアドレス。169.254 または fe80 で始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 네트워크 구간에서만 쓰이는 주소로, 169.254 또는 fe80으로 시작합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresses valables uniquement sur le même segment réseau, commençant par 169.254 ou fe80."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen, die nur im selben Netzwerksegment gelten, beginnend mit 169.254 oder fe80."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Direcciones válidas solo en el mismo segmento de red; empiezan por 169.254 o fe80."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereços válidos só no mesmo segmento de rede, começando por 169.254 ou fe80."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzi validi solo nello stesso segmento di rete, che iniziano con 169.254 o fe80."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса, действующие только в пределах одного сегмента сети; начинаются с 169.254 или fe80."
          }
        }
      }
    },
