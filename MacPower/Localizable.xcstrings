    "settings.icon.tint.onBatteryOnly.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When plugged in, the icon keeps the menu bar’s default color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接上电源时，图标保持菜单栏默认颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接上電源時，圖示保持選單列預設顏色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に接続中は、アイコンはメニューバーの標準の色のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원에 연결되어 있으면 아이콘은 메뉴 막대 기본 색상을 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur secteur, l’icône garde la couleur par défaut de la barre des menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Netzteil behält das Symbol die Standardfarbe der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado a la corriente, el icono mantiene el color predeterminado de la barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado à energia, o ícone mantém a cor padrão da barra de menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l’alimentatore collegato, l’icona mantiene il colore predefinito della barra dei menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
