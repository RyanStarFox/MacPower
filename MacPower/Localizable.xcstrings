    "settings.rings.bluetooth.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Gerät. Es erscheinen nur Geräte, die du auswählst und deren Akku das System meldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No devices yet. Only devices you pick, and that report a battery level, are shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay dispositivos. Solo se muestran los que eliges y cuyo nivel de batería informa el sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil pour l’instant. Seuls ceux que tu choisis, et qui indiquent une batterie, apparaissent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dispositivo. Compaiono solo quelli che scegli e di cui il sistema legge la batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ機器がありません。選んだ、電池を知らせる機器だけを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기기가 없습니다. 직접 고르고 시스템에서 배터리를 읽은 기기만 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dispositivo ainda. Só aparecem os que você escolhe e que informam a bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройств пока нет. Показываются только выбранные, у которых система читает заряд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有添加设备。只显示你选中的、并且系统读得到电量的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有加入裝置。只顯示你選中的、而且系統讀得到電量的裝置。"
          }
        }
      }
    },
