    "settings.rings.ramp.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the white handles to change the ranges. Click a segment to change its colors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动白色把手调整范围，点按色段更改颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動白色把手調整範圍，點按色段更改顏色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白いハンドルをドラッグして範囲を変え、区間をクリックして色を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흰색 핸들을 드래그해 범위를 바꾸고, 구간을 클릭해 색상을 바꿉니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les poignées blanches pour changer les plages. Cliquez sur un segment pour changer ses couleurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die weißen Griffe, um die Bereiche zu ändern. Klicke auf einen Abschnitt, um seine Farben zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los tiradores blancos para cambiar los rangos. Haz clic en un tramo para cambiar sus colores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as alças brancas para mudar as faixas. Clique em um trecho para mudar as cores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le maniglie bianche per cambiare gli intervalli. Fai clic su un tratto per cambiarne i colori."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте белые маркеры, чтобы менять диапазоны. Нажмите на отрезок, чтобы изменить его цвета."
          }
        }
      }
    },
