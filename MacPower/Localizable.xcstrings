    "settings.motion.note.particles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU particles while the panel is open. Uses more power than sheen or lines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板打开时用 GPU 粒子，比高光和细线更费电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板打開時用 GPU 粒子，比高光和細線更費電。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネル表示中はGPUパーティクル。ハイライトや細線より電力を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널이 열려 있는 동안 GPU 파티클을 씁니다. 하이라이트나 선보다 전력이 더 듭니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Particules GPU tant que le panneau est ouvert. Plus gourmand que le reflet ou les lignes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU-Partikel, solange das Panel offen ist. Mehr Verbrauch als Schimmer oder Linien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Partículas GPU mientras el panel está abierto. Más consumo que el brillo o las líneas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Partículas GPU enquanto o painel está aberto. Consome mais que o brilho ou as linhas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Particelle GPU mentre il pannello è aperto. Più dispendioso di riflesso o linee."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU-частицы, пока панель открыта. Больше энергии, чем блик или линии."
          }
        }
      }
    },
