    "settings.rings.half.swap.note": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Diese Größe füllt den Ring zur Hälfte. Ein voller Ring ist immer der gesamte Arbeitsspeicher. Voreingestellt ist ein Viertel davon." } },
        "en": { "stringUnit": { "state": "translated", "value": "This size fills the ring halfway. A full ring is always all of this Mac’s memory. The default is a quarter of that memory." } },
        "es": { "stringUnit": { "state": "translated", "value": "Este tamaño llena el anillo hasta la mitad. El anillo lleno es siempre toda la memoria. El valor inicial es un cuarto de esa memoria." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Cette taille remplit l’anneau à moitié. Un anneau plein correspond toujours à toute la mémoire. La valeur d’origine est un quart de cette mémoire." } },
        "it": { "stringUnit": { "state": "translated", "value": "Questa dimensione riempie l’anello a metà. L’anello pieno è sempre tutta la memoria. Il valore iniziale è un quarto di quella memoria." } },
        "ja": { "stringUnit": { "state": "translated", "value": "この大きさでリングが半分になります。満タンは常にこの Mac のメモリ全体です。初期値はその 4 分の 1 です。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 크기에서 링이 절반이 됩니다. 가득 찬 링은 항상 이 Mac의 메모리 전체입니다. 기본값은 그 4분의 1입니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Este tamanho enche o anel até a metade. O anel cheio é sempre toda a memória. O padrão é um quarto dessa memória." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Этот размер заполняет кольцо наполовину. Полное кольцо — это всегда вся память. По умолчанию это её четверть." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "改这个大小，圆环就走到一半。满圈始终是这台 Mac 的整份内存。默认是内存的四分之一。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "改這個大小，圓環就走到一半。滿圈始終是這台 Mac 的整份記憶體。預設是記憶體的四分之一。" } }
      }
    },
