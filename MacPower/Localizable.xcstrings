    "settings.tint.ramp.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the white handles to change the ranges. Click a segment to change its colors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动白色把手调整电量范围，点按色段更改颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動白色把手調整電量範圍，點按色段更改顏色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白いハンドルをドラッグして範囲を変え、区間をクリックして色を変更します。"
