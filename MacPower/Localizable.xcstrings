    "settings.motion.pulseIcons.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the bolt, battery, laptop, and plug glyphs inside the energy capsule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只作用于能量胶囊里的闪电、电池、电脑和插头图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只作用於能量膠囊裡的閃電、電池、電腦和插頭圖示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エネルギーカプセル内の雷、電池、ノート、プラグのアイコンだけに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에너지 캡슐 안의 번개, 배터리, 노트북, 플러그 아이콘에만 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement les glyphes éclair, batterie, ordinateur et prise dans la capsule d’énergie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betrifft nur Blitz, Akku, Laptop und Stecker in der Energiekapsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los glifos de rayo, batería, portátil y enchufe dentro de la cápsula de energía."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os glifos de raio, bateria, laptop e plugue dentro da cápsula de energia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i glifi di fulmine, batteria, computer e spina nella capsula di energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только молния, батарея, ноутбук и вилка внутри энергетической капсулы."
