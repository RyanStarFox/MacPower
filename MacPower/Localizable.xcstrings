    "settings.rings.colors.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a color to edit it with the same ramp as the menu bar. To change which color a ring uses, pick it next to that ring above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一种颜色，用和菜单栏一样的色带编辑。哪个圆环用哪种颜色，在上面每个圆环右侧更换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按一種顏色，用和選單列一樣的色帶編輯。哪個圓環用哪種顏色，在上面每個圓環右側更換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色をクリックすると、メニューバーと同じカラーバーで編集できます。リングごとの色は、上の各リングの右側で変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상을 클릭하면 메뉴 막대와 같은 색상 막대로 편집할 수 있습니다. 링마다 쓰는 색상은 위의 각 링 오른쪽에서 바꿉니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur une couleur pour la modifier avec la même barre que la barre des menus. Pour changer la couleur d’un anneau, choisissez-la à côté de celui-ci plus haut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf eine Farbe, um sie mit derselben Leiste wie die Menüleiste zu bearbeiten. Welche Farbe ein Ring nutzt, wählst du oben neben dem Ring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
