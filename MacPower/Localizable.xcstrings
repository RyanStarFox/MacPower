    "settings.topApps.window.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Longer is steadier; shorter shows what just happened."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越长越平稳，越短越能反映刚才的情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "越長越平穩，越短越能反映剛才的情況。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長いほど安定し、短いほど直前の様子がわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길수록 안정적이고, 짧을수록 방금 상황을 잘 보여 줍니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus long, c’est plus stable ; plus court, c’est plus réactif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Länger ist ruhiger, kürzer zeigt, was gerade passiert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más largo es más estable; más corto refleja lo que acaba de pasar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais longo é mais estável; mais curto mostra o que acabou de acontecer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più lungo è più stabile; più breve mostra cosa è appena successo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем дольше, тем ровнее; чем короче, тем ближе к тому, что было только что."
          }
        }
      }
    },
