    "welcome.menu.body": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ein Rechtsklick auf das Menüleistensymbol öffnet die Einstellungen oder beendet MacPower. Ein Klick öffnet die Batterieanzeige." } },
        "en": { "stringUnit": { "state": "translated", "value": "Right-click the menu bar icon to open Settings or quit MacPower. Click it to open the battery panel." } },
        "es": { "stringUnit": { "state": "translated", "value": "Un clic derecho abre los ajustes o sale de MacPower. Un clic abre el panel de la batería." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Un clic droit sur l’icône ouvre les réglages ou quitte MacPower. Un clic ouvre le panneau de batterie." } },
        "it": { "stringUnit": { "state": "translated", "value": "Un clic destro apre le impostazioni o esce da MacPower. Un clic apre il pannello della batteria." } },
        "ja": { "stringUnit": { "state": "translated", "value": "メニューバーのアイコンを右クリックすると、設定を開くか MacPower を終了できます。左クリックで電池パネルが開きます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "메뉴 막대 아이콘을 우클릭하면 설정을 열거나 MacPower를 종료할 수 있습니다. 클릭하면 배터리 패널이 열립니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O clique com o botão direito abre os Ajustes ou encerra o MacPower. O clique abre o painel da bateria." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Правый щелчок открывает настройки или завершает MacPower. Обычный щелчок открывает панель батареи." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "右键菜单栏图标可以打开设置，也可以退出 MacPower。左键用来打开电量面板。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "右鍵選單列圖示可以打開設定，也可以結束 MacPower。左鍵用來打開電量面板。" } }
      }
    },
