    "settings.permissions.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether MacPower has the access it needs. You can allow or turn off each item here, or jump to System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 MacPower 是否拿到了需要的权限。可以在这里允许或关闭，也可以跳到系统设置里改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 MacPower 是否取得需要的權限。可以在這裡允許或關閉，也可以跳到系統設定裡改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower に必要なアクセスがあるか確認できます。ここから許可・解除するか、システム設定へ移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower에 필요한 권한이 있는지 확인합니다. 여기서 허용하거나 끄거나, 시스템 설정으로 이동할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez si MacPower a les accès nécessaires. Autorisez ou retirez chaque élément ici, ou ouvrez Réglages Système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie, ob MacPower die nötigen Zugriffe hat. Hier erlauben oder ausschalten – oder in die Systemeinstellungen springen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si MacPower tiene los accesos que necesita. Puedes permitir o desactivar cada uno aquí, o ir a Ajustes del Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja se o MacPower tem os acessos necessários. Autorize ou desative cada item aqui, ou abra Ajustes do Sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla se MacPower ha gli accessi necessari. Puoi consentire o disattivare ogni voce qui, oppure aprire Impostazioni di Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, есть ли у MacPower нужный доступ. Разрешите или отключите здесь либо откройте Системные настройки."
          }
        }
      }
    },
