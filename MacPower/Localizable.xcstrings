    "settings.permissions.lowPower.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing Low Power Mode needs an administrator password once. MacPower then installs a narrow rule that only allows those pmset commands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改节能模式需要输入一次管理员密码。之后 MacPower 会装一条很窄的规则，只允许这些 pmset 命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改節能模式需要輸入一次管理員密碼。之後 MacPower 會裝一條很窄的規則，只允許這些 pmset 命令。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力モードの変更には管理者パスワードが一度必要です。その後、該当の pmset だけを許す狭いルールを入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저전력 모드를 바꾸려면 관리자 암호가 한 번 필요합니다. 이후 해당 pmset 명령만 허용하는 좁은 규칙을 둡니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer le mode économie d’énergie demande un mot de passe administrateur une fois. MacPower installe ensuite une règle limitée à ces commandes pmset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Energiesparmodus ändern braucht einmal das Administratorpasswort. Danach setzt MacPower eine enge Regel nur für diese pmset-Befehle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el modo de bajo consumo pide una vez la contraseña de administrador. Luego MacPower instala una regla estrecha solo para esos pmset."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar o modo de baixo consumo pede a senha de administrador uma vez. Depois o MacPower instala uma regra estreita só para esses pmset."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare la modalità risparmio chiede una volta la password amministratore. Poi MacPower installa una regola stretta solo per quei pmset."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена режима энергосбережения один раз просит пароль администратора. Затем MacPower ставит узкое правило только для этих pmset."
          }
        }
      }
    },
    "settings.permissions.lowPower.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this Mac lacks passwordless sudo, Allow installs /etc/sudoers.d/macpower-lowpower. Revoke removes only that MacPower file. Broader system sudo is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果这台 Mac 还没有免密 sudo，「允许」会写入 /etc/sudoers.d/macpower-lowpower。「撤销」只删 MacPower 这个文件，不动系统里更宽的 sudo。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果這台 Mac 還沒有免密 sudo，「允許」會寫入 /etc/sudoers.d/macpower-lowpower。「撤銷」只刪 MacPower 這個檔案，不動系統裡更寬的 sudo。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードなし sudo が無いとき、「許可」は /etc/sudoers.d/macpower-lowpower を入れます。「取り消し」はその MacPower ファイルだけ消し、広い sudo は触りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 없는 sudo가 없을 때 「허용」은 /etc/sudoers.d/macpower-lowpower를 둡니다. 「철회」는 그 MacPower 파일만 지우며 더 넓은 sudo는 건드리지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans sudo sans mot de passe, Autoriser crée /etc/sudoers.d/macpower-lowpower. Révoquer ne supprime que ce fichier MacPower, pas un sudo plus large."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne passwortloses sudo legt Erlauben /etc/sudoers.d/macpower-lowpower an. Widerrufen löscht nur diese MacPower-Datei, nicht breiteres sudo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin sudo sin contraseña, Permitir crea /etc/sudoers.d/macpower-lowpower. Revocar solo borra ese archivo de MacPower, no un sudo más amplio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem sudo sem senha, Permitir cria /etc/sudoers.d/macpower-lowpower. Revogar remove só esse arquivo do MacPower, não um sudo mais amplo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza sudo senza password, Consenti crea /etc/sudoers.d/macpower-lowpower. Revoca elimina solo quel file MacPower, non un sudo più ampio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без NOPASSWD sudo «Разрешить» создаёт /etc/sudoers.d/macpower-lowpower. «Отозвать» удаляет только этот файл MacPower, не более широкий sudo."
          }
        }
      }
    },
