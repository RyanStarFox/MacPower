    "welcome.menu.title": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Symbol rechtsklicken" } },
        "en": { "stringUnit": { "state": "translated", "value": "Right-click the icon" } },
        "es": { "stringUnit": { "state": "translated", "value": "Clic derecho en el icono" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Clic droit sur l’icône" } },
        "it": { "stringUnit": { "state": "translated", "value": "Fai clic destro sull’icona" } },
        "ja": { "stringUnit": { "state": "translated", "value": "アイコンを右クリック" } },
        "ko": { "stringUnit": { "state": "translated", "value": "아이콘 우클릭" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Clique com o botão direito no ícone" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Щёлкните значок правой кнопкой" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "右键图标" } },
