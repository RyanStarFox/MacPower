    "settings.motion.note.filaments": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few thin lines moving along the ribbon. Low cost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几条细线沿能量带流动，占用很低。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幾條細線沿能量帶流動，占用很低。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数本の細い線がリボンに沿って流れます。負荷は低め。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가느다란 선이 리본을 따라 흐릅니다. 부하가 낮습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques lignes fines le long du ruban. Peu coûteux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige dünne Linien entlang des Bands. Geringe Last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas líneas finas a lo largo de la cinta. Bajo consumo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas linhas finas ao longo da fita. Baixo custo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune linee sottili sul nastro. Poco dispendioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько тонких линий вдоль ленты. Низкая нагрузка."
          }
        }
      }
    },
