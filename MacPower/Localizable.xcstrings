    "settings.permissions.bluetooth.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only to read battery levels of headphones and accessories you already paired, so rings in the panel can show them. MacPower does not scan for nearby devices or send audio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只用来读取你已经配对的耳机和配件的电量，好在面板圆环里显示。不会扫描附近设备，也不会收发音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只用來讀取你已經配對的耳機與配件的電量，好在面板圓環裡顯示。不會掃描附近裝置，也不會收發音訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにペアリングしたヘッドフォンなどの電池残量を読み、パネルのリングに出すためだけに使います。付近の機器を探したり音声を送受信したりしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 페어링된 헤드폰·액세서리의 배터리만 읽어 패널 링에 표시합니다. 주변 기기를 검색하거나 오디오를 주고받지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert uniquement à lire la batterie des écouteurs déjà appairés pour les anneaux du panneau. Pas de scan à proximité ni d’audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zum Lesen des Akkus bereits gekoppelter Kopfhörer für die Ringe im Panel. Kein Scannen in der Nähe und kein Audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lee la batería de auriculares ya emparejados para los anillos del panel. No busca dispositivos cercanos ni envía audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só lê a bateria de fones já pareados para os anéis do painel. Não procura aparelhos por perto nem envia áudio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve solo a leggere la batteria delle cuffie già associate per gli anelli del pannello. Non cerca dispositivi vicini né invia audio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только читает заряд уже сопряжённых наушников для колец в панели. Не ищет устройства рядом и не передаёт звук."
          }
        }
      }
    },
    "settings.permissions.bluetooth.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning Bluetooth off for MacPower is done in System Settings → Privacy & Security → Bluetooth. macOS does not let apps remove that permission by themselves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要关掉 MacPower 的蓝牙权限，请到系统设置 → 隐私与安全性 → 蓝牙。系统不允许应用自己撤销这项权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要關閉 MacPower 的藍牙權限，請到系統設定 → 隱私權與安全性 → 藍牙。系統不允許 App 自己撤銷這項權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower の Bluetooth をオフにするには、システム設定 → プライバシーとセキュリティ → Bluetooth です。アプリ自身では解除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower의 Bluetooth를 끄려면 시스템 설정 → 개인정보 보호 및 보안 → Bluetooth로 이동하세요. 앱이 스스로 권한을 제거할 수는 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour retirer Bluetooth à MacPower : Réglages Système → Confidentialité et sécurité → Bluetooth. L’app ne peut pas le faire seule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth für MacPower aus: Systemeinstellungen → Datenschutz & Sicherheit → Bluetooth. Apps können das nicht selbst entziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para quitar Bluetooth a MacPower: Ajustes del Sistema → Privacidad y seguridad → Bluetooth. La app no puede quitarlo sola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tirar o Bluetooth do MacPower: Ajustes do Sistema → Privacidade e segurança → Bluetooth. O app não remove sozinho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per togliere Bluetooth a MacPower: Impostazioni di Sistema → Privacy e sicurezza → Bluetooth. L’app non può farlo da sola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить Bluetooth для MacPower: Системные настройки → Конфиденциальность и безопасность → Bluetooth. Приложение само это сделать не может."
          }
        }
      }
    },
    "settings.permissions.bluetooth.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许…"
          }
