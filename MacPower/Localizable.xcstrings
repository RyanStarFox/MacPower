    "settings.permissions.login.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switch above adds or removes MacPower right away. Use System Settings if macOS asks you to approve the login item."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上面的开关会立刻加进或移出 MacPower。如果系统还要你批准登录项，再到系统设置里点一下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上面的開關會立刻加進或移出 MacPower。如果系統還要你核准登入項目，再到系統設定裡點一下。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のスイッチですぐ追加・削除します。ログイン項目の承認を求められたらシステム設定で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 스위치로 바로 추가·제거합니다. macOS가 로그인 항목 승인을 물으면 시스템 설정에서 허용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interrupteur ci-dessus ajoute ou retire MacPower tout de suite. Passez par Réglages Système si macOS demande une approbation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schalter oben fügt MacPower sofort hinzu oder entfernt es. Systemeinstellungen nutzen, wenn macOS eine Freigabe verlangt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interruptor de arriba añade o quita MacPower al momento. Usa Ajustes del Sistema si macOS pide aprobarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O interruptor acima adiciona ou remove o MacPower na hora. Use os Ajustes se o macOS pedir aprovação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interruttore sopra aggiunge o toglie MacPower subito. Usa Impostazioni di Sistema se macOS chiede l’approvazione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатель выше сразу добавляет или убирает MacPower. Если macOS просит подтверждение — Системные настройки."
          }
        }
      }
    },
