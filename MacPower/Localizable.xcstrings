        "es": { "stringUnit": { "state": "translated", "value": "Abrir los ajustes de la barra de menús" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvrir les réglages de la barre des menus" } },
        "it": { "stringUnit": { "state": "translated", "value": "Apri le impostazioni della barra dei menu" } },
        "ja": { "stringUnit": { "state": "translated", "value": "「メニューバー」設定を開く" } },
