        "en": { "stringUnit": { "state": "translated", "value": "Start a new row after this" } },
        "es": { "stringUnit": { "state": "translated", "value": "Empezar una fila después de esto" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Commencer une ligne après ceci" } },
        "it": { "stringUnit": { "state": "translated", "value": "Iniziare una riga dopo questo" } },
        "ja": { "stringUnit": { "state": "translated", "value": "この項目の後で改行" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 항목 뒤에서 줄바꿈" } },
