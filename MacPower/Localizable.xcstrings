          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "≡ をドラッグして並べ替えます。少なくとも1つはオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "≡를 끌어 순서를 바꿉니다. 적어도 하나는 켜 두세요."
          }
        },
        "fr": {
