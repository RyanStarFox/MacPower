    "settings.permissions.login.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds or removes MacPower from Login Items so the menu bar icon is ready after you sign in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 MacPower 加进或移出「登录项」，这样登录后菜单栏图标就在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 MacPower 加進或移出「登入項目」，這樣登入後選單列圖示就在。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目に追加または削除し、サインイン後にメニューバーアイコンを出せるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목에 추가하거나 제거해 로그인 후 메뉴 막대 아이콘이 바로 나오게 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ou retire MacPower des éléments d’ouverture pour l’icône de barre des menus après connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt MacPower den Anmeldeobjekten hinzu oder entfernt es, damit das Menüleistensymbol nach der Anmeldung da ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade o quita MacPower de los elementos de inicio para el icono de la barra de menús tras iniciar sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ou remove o MacPower dos Itens de Abertura para o ícone da barra de menus após o login."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge o toglie MacPower dagli elementi di login così l’icona della barra menu c’è dopo l’accesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет или убирает MacPower из объектов входа, чтобы значок в строке меню был после входа."
          }
        }
      }
    },
