    "settings.tint.menuBarDefault.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Menu Bar Default” is black in a light menu bar and white in a dark one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「菜单栏默认色」在浅色菜单栏里是黑色，在深色菜单栏里是白色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「選單列預設色」在淺色選單列中是黑色，在深色選單列中是白色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メニューバーの標準色」は、明るいメニューバーでは黒、暗いメニューバーでは白です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘메뉴 막대 기본 색상’은 밝은 메뉴 막대에서는 검은색, 어두운 메뉴 막대에서는 흰색입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Couleur de la barre des menus » est noire dans une barre claire et blanche dans une barre sombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Menüleisten-Standard“ ist in einer hellen Menüleiste schwarz und in einer dunklen weiß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Color de la barra de menús» es negro en una barra clara y blanco en una oscura."
          }
        },
        "pt-BR": {
          "stringUnit": {
