    "settings.rings.addLineBreak": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Zeilenumbruch hinzufügen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Add a row break" } },
        "es": { "stringUnit": { "state": "translated", "value": "Añadir un salto" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ajouter un saut" } },
        "it": { "stringUnit": { "state": "translated", "value": "Aggiungi un a capo" } },
        "ja": { "stringUnit": { "state": "translated", "value": "改行を追加" } },
        "ko": { "stringUnit": { "state": "translated", "value": "줄바꿈 추가" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Adicionar uma quebra" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Добавить перенос" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "添加换行" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "加入換行" } }
      }
    },
    "tutorial.rings.colors": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Farbvorlage ändert die Farben der Ringe. Akku, Tempo und Temperatur lassen sich auch getrennt einstellen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Color preset changes the ring colors. Battery, speed, and temperature can also be set separately." } },
        "es": { "stringUnit": { "state": "translated", "value": "Ajuste de color cambia los colores de los anillos. Batería, velocidad y temperatura también se pueden ajustar por separado." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Préréglage de couleur change les couleurs des anneaux. Batterie, débit et température se règlent aussi séparément." } },
        "it": { "stringUnit": { "state": "translated", "value": "Preimpostazione colore cambia i colori degli anelli. Batteria, velocità e temperatura si possono regolare anche separatamente." } },
        "ja": { "stringUnit": { "state": "translated", "value": "色のプリセットでリングの色を変えます。バッテリー、速度、温度は分けて調整することもできます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "색상 프리셋으로 링 색을 바꿉니다. 배터리, 속도, 온도는 따로 맞출 수도 있습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Predefinição de cor muda as cores dos anéis. Bateria, velocidade e temperatura também podem ser ajustadas separadamente." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Цветовой пресет меняет цвета колец. Батарею, скорость и температуру можно задать по отдельности." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "变色预设用来改圆环的颜色。电量、速度和温度也可以分开调。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "變色預設用來改圓環的顏色。電量、速度和溫度也可以分開調。" } }
      }
    },
    "tutorial.rings.scale": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Download, Upload, Up/Down und Akkutemperatur gehen von 0 bis unendlich, der Ring nur von 0 bis 100. Erst wenn feststeht, welche Zahl 50 % ist, ist die Zuordnung bestimmt. Bei Swap lässt sich die 50-%-Größe ändern. Voreingestellt ist ein Viertel des Arbeitsspeichers, ein voller Ring ist immer der gesamte." } },
        "en": { "stringUnit": { "state": "translated", "value": "Download, Upload, Up/Down, and Battery Temperature run from 0 to infinity, while the ring only runs from 0 to 100. Setting which number is 50% is what fixes that mapping. Swap’s 50% can be changed too. The default is a quarter of this Mac’s memory, and a full ring is always all of that memory." } },
        "es": { "stringUnit": { "state": "translated", "value": "Descarga, Subida, Subida/Bajada y Temperatura van de 0 a infinito, y el anillo solo de 0 a 100. Hay que fijar qué número es el 50 % para determinar esa correspondencia. El 50 % de Swap también se puede cambiar. El valor inicial es un cuarto de la memoria, y el anillo lleno es siempre toda la memoria." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Téléchargement, Envoi, Débit et Température vont de 0 à l’infini, l’anneau seulement de 0 à 100. Il faut choisir quel nombre vaut 50 % pour fixer cette correspondance. Le 50 % du swap se règle aussi. La valeur d’origine est un quart de la mémoire, et un anneau plein correspond toujours à toute la mémoire." } },
        "it": { "stringUnit": { "state": "translated", "value": "Download, Upload, Invio/Ricezione e Temperatura vanno da 0 a infinito, l’anello solo da 0 a 100. Bisogna stabilire quale numero è il 50% per fissare questa corrispondenza. Anche il 50% dello swap si può cambiare. Il valore iniziale è un quarto della memoria, e l’anello pieno è sempre tutta la memoria." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ダウンロード、アップロード、送受信、バッテリー温度は 0 から無限大、リングは 0 から 100 です。50% がどの数字かを決めて、この対応を定めます。スワップの 50% も変更できます。初期値はメモリの 4 分の 1 で、満タンは常にメモリ全体です。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "다운로드, 업로드, 송수신, 배터리 온도는 0에서 무한대이고, 링은 0에서 100입니다. 50%가 어느 숫자인지 정해야 이 대응이 정해집니다. 스왑의 50%도 바꿀 수 있습니다. 기본값은 메모리의 4분의 1이고, 가득 찬 링은 항상 메모리 전체입니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Download, Upload, Envio/Recebimento e Temperatura vão de 0 ao infinito, e o anel só de 0 a 100. É preciso definir qual número é 50% para determinar essa correspondência. Os 50% do swap também podem ser alterados. O padrão é um quarto da memória, e o anel cheio é sempre toda a memória." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Загрузка, Отдача, Обмен и Температура идут от 0 до бесконечности, а кольцо только от 0 до 100. Нужно задать, какое число соответствует 50%, чтобы определить это соответствие. Для подкачки 50% тоже можно изменить. По умолчанию это четверть памяти, а полное кольцо — всегда вся память." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "下载、上传、上传下载和电池温度是 0 到正无穷，圆环是 0 到 100，所以要规定 50% 对应哪一个数字，才能确定 0 到正无穷和 0 到 100 的对应关系。交换的 50% 也可以改，默认是这台 Mac 物理内存的四分之一，满圈始终是整份内存。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "下載、上傳、上傳下載和電池溫度是 0 到正無窮，圓環是 0 到 100，所以要規定 50% 對應哪一個數字，才能確定 0 到正無窮和 0 到 100 的對應關係。交換的 50% 也可以改，預設是這台 Mac 實體記憶體的四分之一，滿圈始終是整份記憶體。" } }
      }
    },
    "tutorial.rings.thermal": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Das System liefert keinen fortlaufenden Prozentwert für den Wärmestatus, nur vier Stufen: Normal, Erhöht, Ernst und Kritisch. Wie viel des Rings jede Stufe füllt, legst du selbst fest. Voreingestellt sind 25 %, 50 %, 75 % und 100 %." } },
        "en": { "stringUnit": { "state": "translated", "value": "The system does not report a continuous thermal percentage. It only provides four levels: Nominal, Fair, Serious, and Critical. You choose how much of the ring each level fills. The defaults are 25%, 50%, 75%, and 100%." } },
        "es": { "stringUnit": { "state": "translated", "value": "El sistema no da un porcentaje continuo del estado térmico. Solo ofrece cuatro niveles: Normal, Elevado, Grave y Crítico. Tú decides cuánto del anillo ocupa cada nivel. Por defecto son 25 %, 50 %, 75 % y 100 %." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le système ne donne pas un pourcentage continu pour l’état thermique. Il ne fournit que quatre niveaux : Normal, Élevé, Grave et Critique. Tu choisis la part de l’anneau pour chaque niveau. Par défaut : 25 %, 50 %, 75 % et 100 %." } },
        "it": { "stringUnit": { "state": "translated", "value": "Il sistema non fornisce una percentuale continua per lo stato termico. Offre solo quattro livelli: Normale, Elevato, Grave e Critico. Decidi tu quanta parte dell’anello occupa ciascun livello. I valori predefiniti sono 25%, 50%, 75% e 100%." } },
        "ja": { "stringUnit": { "state": "translated", "value": "システムは熱状態の連続した割合を渡しません。正常、高め、深刻、危険の四段階だけです。各段階がリングのどれだけを占めるかは自分で決めます。初期値は 25%、50%、75%、100% です。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "시스템은 열 상태의 연속된 백분율을 주지 않습니다. 정상, 높음, 심각, 위험 네 단계만 제공합니다. 각 단계가 링의 얼마를 채울지는 직접 정합니다. 기본값은 25%, 50%, 75%, 100%입니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O sistema não informa uma porcentagem contínua do estado térmico. Ele só oferece quatro níveis: Normal, Elevado, Grave e Crítico. Você escolhe quanto do anel cada nível ocupa. O padrão é 25%, 50%, 75% e 100%." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Система не сообщает непрерывный процент теплового состояния. Она даёт только четыре уровня: Норма, Повышен, Серьёзно и Критично. Вы сами задаёте, какую часть кольца занимает каждый уровень. По умолчанию это 25%, 50%, 75% и 100%." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "系统没有给出连续的热状态百分比，只提供四个档位：正常、偏高、严重、危急。每一档占圆环的多少要自己定。默认是 25%、50%、75%、100%。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "系統沒有給出連續的熱狀態百分比，只提供四個檔位：正常、偏高、嚴重、危急。每一檔占圓環的多少要自己定。預設是 25%、50%、75%、100%。" } }
      }
    },
    "tutorial.panel.arrow": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Eingeschaltet zeigt der Bereich einen Pfeil auf das Symbol in der Menüleiste. Ausgeschaltet ist das Fenster nur abgerundet, ohne Pfeil." } },
        "en": { "stringUnit": { "state": "translated", "value": "On, the panel has an arrow pointing at the menu-bar icon. Off, the panel is a rounded window with no arrow." } },
        "es": { "stringUnit": { "state": "translated", "value": "Activado, el panel tiene una flecha hacia el icono de la barra de menús. Desactivado, el panel es una ventana redondeada sin flecha." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Activé, le panneau a une flèche vers l’icône de la barre des menus. Désactivé, c’est une fenêtre arrondie sans flèche." } },
        "it": { "stringUnit": { "state": "translated", "value": "Attivo, il pannello ha una freccia verso l’icona della barra dei menu. Disattivo, è una finestra arrotondata senza freccia." } },
        "ja": { "stringUnit": { "state": "translated", "value": "オンにすると、パネルの上にメニューバーのアイコンを指す矢印が出ます。オフにすると、矢印のない角丸のパネルになります。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "켜면 패널 위에 메뉴 막대 아이콘을 가리키는 화살표가 나옵니다. 끄면 화살표 없는 둥근 패널이 됩니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Ligado, o painel tem uma seta apontando para o ícone na barra de menus. Desligado, o painel é uma janela arredondada sem seta." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Включённая стрелка указывает на значок в строке меню. Выключенная убирает стрелку, и панель остаётся скруглённым окном." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开后，面板上方会有一个箭头指向菜单栏图标。关掉之后，面板是没有箭头的圆角窗口。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "打開後，面板上方會有一個箭頭指向選單列圖示。關掉之後，面板是沒有箭頭的圓角視窗。" } }
      }
    },
    "tutorial.panel.button": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Eigener Block fügt einen Bereich nur mit der Einstellungen-Schaltfläche hinzu. In einem Block legt sie in den Bereich, den du unter Block wählst. Nur beim Rechtsklick lässt die Schaltfläche aus dem Fenster weg; ein Rechtsklick auf das Symbol öffnet die Einstellungen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Its own block adds a block that contains only the Settings button. Inside a block places the button in the block you pick with Host block. Only when right-clicking the icon leaves the button out of the panel; right-click the menu-bar icon to open Settings." } },
        "es": { "stringUnit": { "state": "translated", "value": "Bloque propio añade un bloque solo con el botón de ajustes. Dentro de un bloque lo pone en el bloque que eliges en Bloque. Solo al hacer clic derecho lo quita del panel; el clic derecho en el icono abre los ajustes." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Bloc séparé ajoute un bloc qui ne contient que le bouton Réglages. Dans un bloc le place dans le bloc choisi avec Bloc hôte. Uniquement au clic droit le retire du panneau ; un clic droit sur l’icône ouvre Réglages." } },
        "it": { "stringUnit": { "state": "translated", "value": "Blocco dedicato aggiunge un blocco con solo il pulsante Impostazioni. Dentro un blocco lo mette nel blocco scelto con Blocco. Solo con il clic destro lo toglie dal pannello; il clic destro sull’icona apre Impostazioni." } },
        "ja": { "stringUnit": { "state": "translated", "value": "独立したブロックは、設定ボタンだけのブロックを足します。既存のブロック内は、表示するブロックで選んだ場所にボタンを置きます。右クリック時のみでは、左クリックのパネルに設定ボタンは出ず、メニューバーのアイコンを右クリックすると設定を開けます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "별도의 블록은 설정 버튼만 있는 블록을 추가합니다. 기존 블록 안은 호스트 블록에서 고른 곳에 버튼을 둡니다. 오른쪽 클릭 때만은 왼쪽 클릭 패널에 설정 버튼을 두지 않고, 메뉴 막대 아이콘을 오른쪽 클릭하면 설정을 엽니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Bloco próprio acrescenta um bloco só com o botão de ajustes. Dentro de um bloco coloca o botão no bloco escolhido em Bloco. Somente no clique direito tira o botão do painel; o clique direito no ícone abre os ajustes." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отдельный блок добавляет блок только с кнопкой настроек. Внутри блока ставит кнопку в блок, выбранный в Блок. Только по правому клику убирает кнопку из панели; правый клик по значку открывает настройки." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "单独一个区块会在面板里多出一块，上面只有设置按钮。出现在某个区块里时，按钮放进你选的那一块，再用「所在区块」指定位置。仅右键图标时出现：左键打开的面板里没有设置按钮，右键菜单栏图标可以打开设置。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "單獨一個區塊會在面板裡多出一塊，上面只有設定按鈕。出現在某個區塊裡時，按鈕放進你選的那一塊，再用「所在區塊」指定位置。僅右鍵圖示時出現：左鍵打開的面板裡沒有設定按鈕，右鍵選單列圖示可以打開設定。" } }
      }
    },
    "tutorial.panel.blocks": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Der Griff links zieht die Reihenfolge, der Schalter blendet den Bereich ein oder aus, und mindestens ein Bereich bleibt sichtbar. Standardmäßig liegt eine Linie zwischen je zwei eingeschalteten Bereichen; in der Reihenfolge kannst du eine Trennlinie ziehen, eine weitere hinzufügen oder eine entfernen." } },
        "en": { "stringUnit": { "state": "translated", "value": "The grip on the left drags the order, each switch shows or hides that block, and at least one block stays on. By default there is a line between every two blocks that are on; in the panel order list you can drag a divider, add another, or remove one." } },
        "es": { "stringUnit": { "state": "translated", "value": "El asa de la izquierda arrastra el orden, cada interruptor muestra u oculta ese bloque, y al menos un bloque sigue visible. De forma predeterminada hay una línea entre cada dos bloques activados; en la lista del orden puedes arrastrar un separador, añadir otro o quitar uno." } },
        "fr": { "stringUnit": { "state": "translated", "value": "La poignée à gauche fait glisser l’ordre, chaque interrupteur affiche ou masque le bloc, et au moins un bloc reste visible. Par défaut, une ligne sépare chaque paire de blocs activés ; dans la liste d’ordre, tu peux faire glisser un séparateur, en ajouter un ou en retirer un." } },
        "it": { "stringUnit": { "state": "translated", "value": "La presa a sinistra trascina l’ordine, ogni interruttore mostra o nasconde il blocco, e almeno un blocco resta visibile. Per impostazione predefinita c’è una linea tra ogni due blocchi attivi; nell’elenco dell’ordine puoi trascinare un separatore, aggiungerne un altro o rimuoverne uno." } },
        "ja": { "stringUnit": { "state": "translated", "value": "左のグリップで並べ替え、スイッチでそのブロックを出します。少なくとも一つは表示したままにします。初期状態ではオンのブロックのあいだに区切り線があり、順序リストで区切り線をドラッグ、追加、削除できます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "왼쪽 손잡이로 순서를 끌고, 스위치로 그 블록을 켜거나 끕니다. 최소한 한 블록은 켜 둡니다. 기본값은 켜진 블록 사이마다 구분선이 있고, 패널 순서 목록에서 구분선을 끌거나 추가하거나 지울 수 있습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "A alça à esquerda arrasta a ordem, cada interruptor mostra ou oculta o bloco, e pelo menos um bloco continua visível. Por padrão há uma linha entre cada dois blocos ligados; na lista de ordem você pode arrastar um divisor, adicionar outro ou remover um." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ручка слева перетаскивает порядок, переключатель показывает или скрывает блок, и хотя бы один блок остаётся включённым. По умолчанию линия стоит между каждыми двумя включёнными блоками; в списке порядка разделитель можно перетащить, добавить ещё один или удалить." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "左边的握把用来拖动排序，开关决定这一块出不出现。至少要留一块开着。默认每两个打开的板块之间都有一条分割线；在面板顺序列表里可以拖动分割线，也可以再加一条或删掉。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "左邊的握把用來拖動排序，開關決定這一塊出不出現。至少要留一塊開著。預設每兩個打開的板塊之間都有一條分割線；在面板順序清單裡可以拖動分割線，也可以再加一條或刪掉。" } }
      }
    },
    "tutorial.rings.body": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Öffne Ringe in der Seitenleiste. Der Griff links in der Zeile zieht die Reihenfolge, der Schalter blendet den Ring ein oder aus. Zwei Reihen verteilt sie. Farbvorlage ändert die Farben. Die Schiebe-Taste bei Download, Upload, Up/Down und Akkutemperatur öffnet die Hälfte, etwa Download bei 50 % oder Temperatur bei 50 %. Beim Wärmestatus setzt dieselbe Taste die Prozentwerte für Normal, Erhöht, Ernst und Kritisch." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open Rings in the sidebar. The grip on the left of a row drags the order, and the switch shows or hides that ring. Two rows splits them. Color preset changes the colors. The slider button on Download, Upload, Up/Down, and Battery Temperature opens the halfway scale, such as Download at 50% or Temperature at 50%. On Thermal State, the same button sets the ring percent for Nominal, Fair, Serious, and Critical." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre Anillos en la barra lateral. El asa de la izquierda arrastra el orden, y el interruptor muestra u oculta ese anillo. Dos filas los reparte. Ajuste de color cambia los colores. El botón del control en Descarga, Subida, Subida/Bajada y Temperatura de la batería abre la escala de la mitad, como Descarga al 50 % o Temperatura al 50 %. En Estado térmico, el mismo botón fija el porcentaje del anillo para Normal, Elevado, Grave y Crítico." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvre Anneaux dans la barre latérale. La poignée à gauche fait glisser l’ordre, et l’interrupteur affiche ou masque l’anneau. Deux rangées les répartit. Préréglage de couleur change les couleurs. Le bouton du curseur sur Téléchargement, Envoi, Débit et Température de la batterie ouvre l’échelle de moitié, par exemple Débit descendant à 50 % ou Température à 50 %. Pour État thermique, le même bouton fixe le pourcentage de l’anneau pour Normal, Élevé, Grave et Critique." } },
        "it": { "stringUnit": { "state": "translated", "value": "Apri Anelli nella barra laterale. La presa a sinistra trascina l’ordine, e l’interruttore mostra o nasconde l’anello. Due righe li divide. Preimpostazione colore cambia i colori. Il pulsante del cursore su Download, Upload, Invio/Ricezione e Temperatura della batteria apre la scala a metà, per esempio Download al 50% o Temperatura al 50%. Per Stato termico, lo stesso pulsante imposta la percentuale dell’anello per Normale, Elevato, Grave e Critico." } },
        "ja": { "stringUnit": { "state": "translated", "value": "サイドバーの「リング」を開きます。行の左にあるグリップで並べ替え、スイッチで表示を切り替えます。「2行にする」で二段に分かれます。色のプリセットで色を変えます。ダウンロード、アップロード、送受信、バッテリー温度の行にあるスライダーボタンは、半分の目盛りを開きます。ダウンロード 50% や温度 50% です。熱状態の同じボタンでは、正常、高め、深刻、危険がリング上で何パーセントになるかを決めます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "사이드바에서 링을 엽니다. 줄 왼쪽의 손잡이로 순서를 끌고, 스위치로 그 링을 켜거나 끕니다. 두 줄로는 링을 두 줄로 나눕니다. 색상 프리셋으로 색을 바꿉니다. 다운로드, 업로드, 송수신, 배터리 온도 줄의 슬라이더 버튼은 절반 눈금을 엽니다. 다운로드 50%나 온도 50%입니다. 열 상태의 같은 버튼에서는 정상, 높음, 심각, 위험이 링에서 몇 퍼센트인지 정합니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Abra Anéis na barra lateral. A alça à esquerda arrasta a ordem, e o interruptor mostra ou oculta o anel. Duas linhas reparte os anéis. Predefinição de cor muda as cores. O botão do controle em Download, Upload, Envio/Recebimento e Temperatura da bateria abre a escala da metade, como Download em 50% ou Temperatura em 50%. Em Estado térmico, o mesmo botão define a porcentagem do anel para Normal, Elevado, Grave e Crítico." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте Кольца на боковой панели. Ручка слева перетаскивает порядок, а переключатель показывает или скрывает кольцо. Два ряда делит их на два ряда. Цветовой пресет меняет цвета. Кнопка ползунка в строках Загрузка, Отдача, Обмен и Температура аккумулятора открывает шкалу половины, например Загрузка на 50% или Температура на 50%. Для Тепловой статус та же кнопка задаёт проценты кольца для Норма, Повышен, Серьёзно и Критично." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在侧边栏打开「圆环」。每行左边的握把用来拖动排序，开关决定这一项出不出现；「分成两行」会把圆环排成两排。变色预设用来改颜色。下载速度、上传速度、上传下载和电池温度这几行上的滑杆按钮，会打开一半刻度，例如「下载 50%」或「温度 50%」。热状态的同一个按钮用来设定正常、偏高、严重、危急各占的百分比。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在側邊欄打開「圓環」。每行左邊的握把用來拖動排序，開關決定這一項出不出現；「分成兩行」會把圓環排成兩排。變色預設用來改顏色。下載速度、上傳速度、上傳下載和電池溫度這幾行上的滑桿按鈕，會打開一半刻度，例如「下載 50%」或「溫度 50%」。熱狀態的同一個按鈕用來設定正常、偏高、嚴重、危急各占的百分比。" } }
      }
    },
    "tutorial.flow.body": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Öffne Energie in der Seitenleiste. Farbvorlage färbt alle Zustände auf einmal, oder du stellst Laden, Akku, Netzteil halten und Unterversorgt einzeln ein. Eigene Bewegungsfarbe ändert nur die laufende Farbe. Icon-Paket tauscht die Symbole an den beiden Enden, Icons atmen lässt sie pulsieren. Stil wählt die Bewegung. Ist sie aus, lässt sich Bildrate (Partikel / Linien) nicht ändern." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open Energy in the sidebar. Color preset tints every state at once, or you edit Charging, On battery, Adapter hold, and Underpowered separately. Custom motion color changes only the moving color. Icon Pack replaces the icons on the two ends, and Pulse icons breathes them. Style chooses the motion. While it is off, Particle / line frame rate cannot be changed." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre Energía en la barra lateral. Ajuste de color tiñe todos los estados a la vez, o editas Cargando, Con batería, Adaptador en espera y Potencia insuficiente por separado. Color de animación cambia solo el color que se mueve. Paquete de iconos sustituye los iconos de los dos extremos, y Pulsación de iconos los hace latir. Estilo elige el movimiento. Si está apagado, Frecuencia (partículas / líneas) no se puede cambiar." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvre Énergie dans la barre latérale. Préréglage de couleur teinte tous les états d’un coup, ou tu règles Charge, Sur batterie, Maintien adaptateur et Sous-alimenté un par un. Couleur d’animation ne change que la couleur en mouvement. Pack d’icônes remplace les icônes aux deux bouts, et Pulsation des icônes les fait respirer. Style choisit le mouvement. S’il est arrêté, Fréquence (particules / lignes) ne se règle pas." } },
        "it": { "stringUnit": { "state": "translated", "value": "Apri Energia nella barra laterale. Preimpostazione colore colora tutti gli stati insieme, oppure regoli In carica, A batteria, Adattatore in attesa e Potenza insufficiente uno per uno. Colore del movimento cambia solo il colore che scorre. Pacchetto icone sostituisce le icone alle due estremità, e Pulsazione delle icone le fa respirare. Stile sceglie il movimento. Se è spento, Frequenza (particelle / linee) non si può cambiare." } },
        "ja": { "stringUnit": { "state": "translated", "value": "サイドバーの「エネルギー」を開きます。色のプリセットですべての状態をまとめて塗るか、充電中、バッテリー駆動、アダプタ維持、電力不足を別々に調整します。モーション色を指定は、流れている色だけを変えます。アイコンパックは両端のアイコンを替え、アイコンの脈動はそれらを一緒に拡縮します。スタイルで動きを選びます。動きを切っているあいだ、粒子/細線のフレームレートは変更できません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "사이드바에서 에너지를 엽니다. 색상 프리셋으로 모든 상태를 한 번에 칠하거나, 충전 중, 배터리 사용, 어댑터 유지, 전력 부족을 따로 조정합니다. 모션 색상 지정은 흐르는 색만 바꿉니다. 아이콘 팩은 양끝 아이콘을 바꾸고, 아이콘 호흡은 그 아이콘을 함께 커졌다 작아지게 합니다. 스타일로 움직임을 고릅니다. 움직임을 끄면 입자/선 프레임 레이트는 바꿀 수 없습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Abra Energia na barra lateral. Predefinição de cor pinta todos os estados de uma vez, ou você ajusta Carregando, Na bateria, Adaptador em espera e Potência insuficiente um a um. Cor do movimento muda só a cor que se move. Pacote de ícones troca os ícones das duas pontas, e Pulsação dos ícones faz com que respirem. Estilo escolhe o movimento. Enquanto estiver desligado, Taxa de quadros (partículas / linhas) não pode ser alterada." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте Энергия на боковой панели. Цветовой пресет красит все состояния сразу, либо вы правите Зарядка, От батареи, Удержание от сети и Нехватка мощности по отдельности. Свой цвет анимации меняет только цвет движения. Набор значков заменяет значки на двух концах, а Пульсация значков заставляет их дышать. Стиль выбирает движение. Пока оно выключено, Частота кадров (частицы / линии) не меняется." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在侧边栏打开「能量流」。变色预设可以一次给所有状态上色，也可以分别调充电中、使用电池、电源维持和功率不足。自定义动效颜色只改流动的颜色。图标套装更换两端的图标，图标呼吸让它们一起缩放。样式用来选择动效；设为关闭后，粒子/细线帧率不能改。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在側邊欄打開「能量流」。變色預設可以一次給所有狀態上色，也可以分別調充電中、使用電池、電源維持和功率不足。自訂動效顏色只改流動的顏色。圖示套裝更換兩端的圖示，圖示呼吸讓它們一起縮放。樣式用來選擇動效；設為關閉後，粒子/細線幀率不能改。" } }
      }
    },
    "tutorial.topApps.view": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ansicht kann Liste, Balken oder Säulen sein. Die Länge von Balken und Säulen bezieht sich auf die App mit dem höchsten Wert in dieser Gruppe. Die Zahl selbst bleibt die Energieauswirkung." } },
        "en": { "stringUnit": { "state": "translated", "value": "View can be List, Bar chart, or Column chart. Bar and column length is relative to the highest app in the group. The number itself is still the energy impact." } },
        "es": { "stringUnit": { "state": "translated", "value": "Vista puede ser Lista, Barras o Columnas. La longitud de barras y columnas es relativa a la app más alta del grupo. El número sigue siendo el impacto energético." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Affichage peut être Liste, Barres ou Colonnes. La longueur des barres et des colonnes est relative à l’app la plus haute du groupe. Le nombre reste l’impact énergétique." } },
        "it": { "stringUnit": { "state": "translated", "value": "Vista può essere Elenco, Barre o Colonne. La lunghezza di barre e colonne è relativa all’app più alta del gruppo. Il numero resta l’impatto energetico." } },
        "ja": { "stringUnit": { "state": "translated", "value": "表示はリスト、横棒、縦棒から選べます。棒の長さはこの中で一番大きいアプリに対する割合です。数字そのものはエネルギー影響のままです。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "보기는 목록, 가로 막대, 세로 막대 중에서 고릅니다. 막대 길이는 이 묶음에서 가장 높은 앱에 대한 비율입니다. 숫자 자체는 에너지 영향입니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Visualização pode ser Lista, Barras ou Colunas. O comprimento das barras e colunas é relativo ao app mais alto do grupo. O número em si continua sendo o impacto de energia." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Вид может быть Список, Полосы или Столбцы. Длина полос и столбцов считается от самого высокого приложения в группе. Само число остаётся влиянием на энергию." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "视图可以是文字、条形图或柱状图。条和柱的长度是相对这一组里最高的应用。数字本身仍是对能耗的影响。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "檢視可以是文字、橫條圖或柱狀圖。條和柱的長度是相對這一組裡最高的 App。數字本身仍是對能耗的影響。" } }
      }
    },
    "tutorial.topApps.window": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Abtastintervall legt fest, wie oft gemessen wird. Zeitfenster legt fest, über welche Dauer gemittelt wird. Angezeigte Apps legt fest, wie viele Einträge erscheinen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Sample interval is how often it measures. Sample window is how long a stretch is averaged. Apps shown is how many entries appear." } },
        "es": { "stringUnit": { "state": "translated", "value": "Intervalo de muestreo decide cada cuánto se mide. Ventana de muestreo decide cuánto tiempo se promedia. Apps mostradas decide cuántas entradas aparecen." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Intervalle d’échantillonnage décide de la fréquence des mesures. Fenêtre d’échantillonnage décide de la durée moyennée. Apps affichées décide du nombre de lignes." } },
        "it": { "stringUnit": { "state": "translated", "value": "Intervallo di campionamento decide ogni quanto si misura. Finestra di campionamento decide quanto tempo viene mediato. App mostrate decide quante voci compaiono." } },
        "ja": { "stringUnit": { "state": "translated", "value": "サンプリング間隔は、どれくらいの頻度で測るかを決めます。サンプリング時間は、どれだけの長さを平均するかを決めます。表示する数は、何件出すかを決めます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "샘플링 간격은 얼마나 자주 측정할지를 정합니다. 샘플링 시간은 얼마만큼의 구간을 평균낼지를 정합니다. 표시 개수는 몇 개를 보여줄지를 정합니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Intervalo de amostragem define de quanto em quanto ela mede. Janela de amostragem define quanto tempo entra na média. Apps exibidos define quantas linhas aparecem." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Интервал выборки задаёт, как часто идёт измерение. Окно выборки задаёт, за какой отрезок берётся среднее. Число приложений задаёт, сколько строк показывать." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "采样间隔决定多久统计一次。采样时间决定拿多长的一段来平均。显示个数决定列出前几名。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "採樣間隔決定多久統計一次。採樣時間決定拿多長的一段來平均。顯示個數決定列出前幾名。" } }
      }
    },
    "tutorial.topApps.impact": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Zahl ist dieselbe Energieauswirkung wie im Aktivitätsmonitor: CPU, Weckrufe, GPU, Festplatte und Netzwerk der Prozesse dieser App werden addiert und durch die Sekunden dieses Abtastintervalls geteilt. Angezeigt wird der Mittelwert dieser Raten über das Zeitfenster. Fehlt die App in einem Intervall, zählt das Intervall als 0. Der Aktivitätsmonitor nutzt sein eigenes kurzes Fenster und einen anderen Takt, deshalb liegen die Zahlen nah beieinander, sind aber nicht gleich." } },
        "en": { "stringUnit": { "state": "translated", "value": "The number is the same energy impact Activity Monitor uses. It adds CPU, wakeups, GPU, disk, and network across that app’s processes, then divides by the seconds in that sample to get a rate. What you see is the average of those rates over the sample window. If the app is missing from a sample, that sample counts as 0. Activity Monitor uses its own short window and a different refresh, so the two numbers stay close without matching exactly." } },
        "es": { "stringUnit": { "state": "translated", "value": "El número es el mismo impacto energético que usa Monitor de Actividad. Suma CPU, despertares, GPU, disco y red de los procesos de esa app, y lo divide por los segundos de esa muestra para obtener una tasa. Lo que ves es el promedio de esas tasas en la ventana de muestreo. Si la app no aparece en una muestra, esa muestra cuenta como 0. Monitor de Actividad usa su propia ventana corta y otro ritmo de actualización, así que los dos números se acercan sin coincidir del todo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le nombre est le même impact énergétique que celui du Moniteur d’activité. Il additionne CPU, réveils, GPU, disque et réseau des processus de l’app, puis divise par les secondes de cet échantillon pour obtenir un débit. Ce qui s’affiche est la moyenne de ces débits sur la fenêtre. Si l’app manque dans un échantillon, celui-ci compte pour 0. Le Moniteur d’activité utilise sa propre fenêtre courte et un autre rythme, donc les deux nombres restent proches sans être identiques." } },
        "it": { "stringUnit": { "state": "translated", "value": "Il numero è lo stesso impatto energetico di Monitoraggio Attività. Somma CPU, risvegli, GPU, disco e rete dei processi di quell’app, poi divide per i secondi di quel campione e ottiene un tasso. Quello che vedi è la media di questi tassi nella finestra di campionamento. Se l’app manca in un campione, quel campione conta come 0. Monitoraggio Attività usa una finestra breve propria e un altro aggiornamento, quindi i due numeri restano vicini senza coincidere." } },
        "ja": { "stringUnit": { "state": "translated", "value": "数字はアクティビティモニタと同じエネルギー影響です。そのアプリの各プロセスについて、CPU、起動、GPU、ディスク、ネットワークを合計し、そのサンプルの秒数で割って速度にします。表示されるのは、サンプリング時間のあいだのこの速度の平均です。あるサンプルにそのアプリがいないときは、その回を 0 として平均します。アクティビティモニタは自分の短い区間と別の更新間隔を見るので、二つの数字は近くなりますが、まったく同じにはなりません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "숫자는 활성 상태 보기와 같은 에너지 영향입니다. 그 앱의 프로세스들에 대해 CPU, 깨우기, GPU, 디스크, 네트워크를 더한 뒤, 그 샘플의 초로 나눠 속도를 냅니다. 보이는 값은 샘플링 시간 동안 이 속도의 평균입니다. 어떤 샘플에 그 앱이 없으면 그 회는 0으로 평균에 넣습니다. 활성 상태 보기는 자기 짧은 구간과 다른 갱신 주기를 보므로, 두 숫자는 가깝지만 완전히 같지는 않습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O número é o mesmo impacto de energia do Monitor de Atividade. Ele soma CPU, ativações, GPU, disco e rede dos processos desse app e divide pelos segundos daquela amostra, gerando uma taxa. O que aparece é a média dessas taxas na janela de amostragem. Se o app não aparece numa amostra, essa amostra conta como 0. O Monitor de Atividade usa a própria janela curta e outro ritmo de atualização, então os dois números ficam próximos sem serem idênticos." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Число — то же влияние на энергию, что и в Мониторинге системы. Оно складывает CPU, пробуждения, GPU, диск и сеть по процессам приложения и делит на секунды этой выборки, получая скорость. На экране среднее этих скоростей за окно выборки. Если в какой-то выборке приложения не было, она считается как 0. Мониторинг системы смотрит своё короткое окно и обновляется в другом ритме, поэтому числа близки, но не совпадают точно." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "数字用的是和活动监视器同一套「对能耗的影响」：把这个应用各个进程在 CPU、唤醒、GPU、磁盘和网络上的消耗加起来，再除以这一段采样的秒数，得到一个速率。这里显示的是采样时间里这些速率的平均值。某一段采样里这个应用没出现，这一段就按 0 计入。活动监视器看的是它自己的短窗口，刷新时间也不一样，所以两个数字接近，但不会完全相同。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "數字用的是和活動監視器同一套「對能耗的影響」：把這個 App 各個行程在 CPU、喚醒、GPU、磁碟和網路上的消耗加起來，再除以這一段採樣的秒數，得到一個速率。這裡顯示的是採樣時間裡這些速率的平均值。某一段採樣裡這個 App 沒出現，這一段就按 0 計入。活動監視器看的是它自己的短視窗，重新整理時間也不一樣，所以兩個數字接近，但不會完全相同。" } }
      }
    },
    "tutorial.topApps.body": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Öffne Apps in der Seitenleiste. Ansicht kann Liste, Balken oder Säulen sein. Abtastintervall legt fest, wie oft gemessen wird. Zeitfenster und Angezeigte Apps stehen auf derselben Seite." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open Apps in the sidebar. View can be List, Bar chart, or Column chart. Sample interval is how often it measures. Sample window and Apps shown are on the same page." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre Apps en la barra lateral. Vista puede ser Lista, Barras o Columnas. Intervalo de muestreo decide cada cuánto se mide. Ventana de muestreo y Apps mostradas están en la misma página." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvre Apps dans la barre latérale. Affichage peut être Liste, Barres ou Colonnes. Intervalle d’échantillonnage décide de la fréquence des mesures. Fenêtre d’échantillonnage et Apps affichées sont sur la même page." } },
        "it": { "stringUnit": { "state": "translated", "value": "Apri App nella barra laterale. Vista può essere Elenco, Barre o Colonne. Intervallo di campionamento decide ogni quanto si misura. Finestra di campionamento e App mostrate sono nella stessa pagina." } },
        "ja": { "stringUnit": { "state": "translated", "value": "サイドバーの「消費」を開きます。表示はリスト、横棒、縦棒から選べます。サンプリング間隔は、どれくらいの頻度で測るかを決めます。サンプリング時間と表示する数も同じページにあります。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "사이드바에서 소비를 엽니다. 보기는 목록, 가로 막대, 세로 막대 중에서 고릅니다. 샘플링 간격은 얼마나 자주 측정할지를 정합니다. 샘플링 시간과 표시 개수도 같은 페이지에 있습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Abra Apps na barra lateral. Visualização pode ser Lista, Barras ou Colunas. Intervalo de amostragem define de quanto em quanto ela mede. Janela de amostragem e Apps exibidos ficam na mesma página." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте Топ на боковой панели. Вид может быть Список, Полосы или Столбцы. Интервал выборки задаёт, как часто идёт измерение. Окно выборки и Число приложений находятся на той же странице." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在侧边栏打开「耗电」。视图可以是文字、条形图或柱状图。采样间隔决定多久统计一次。采样时间和显示个数也在这一页。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在側邊欄打開「耗電」。檢視可以是文字、橫條圖或柱狀圖。採樣間隔決定多久統計一次。採樣時間和顯示個數也在這一頁。" } }
      }
    },
    "tutorial.lowPower.strategy": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die linke Taste zeigt den Kurznamen der aktuellen Regel. Darüber lassen sich Leistung, Energiesparen, Nur bei Batterie sparen und Nur am Netz sparen wählen." } },
        "en": { "stringUnit": { "state": "translated", "value": "The left button shows the short name of the current rule. Open it to choose Performance, Low Power, Low Power on battery, or Low Power when plugged in." } },
        "es": { "stringUnit": { "state": "translated", "value": "El botón de la izquierda muestra el nombre corto de la regla actual. Ábrelo para elegir Rendimiento, Ahorro de energía, Ahorro solo con batería o Ahorro solo con corriente." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le bouton de gauche affiche le nom court de la règle en cours. Ouvre-le pour choisir Performance, Économie d’énergie, Économie sur batterie ou Économie sur secteur." } },
        "it": { "stringUnit": { "state": "translated", "value": "Il pulsante a sinistra mostra il nome breve della regola attuale. Aprilo per scegliere Prestazioni, Risparmio energetico, Risparmio solo a batteria o Risparmio solo da rete." } },
        "ja": { "stringUnit": { "state": "translated", "value": "左のボタンには、いまの方針の短い名前が出ます。開くと、性能、省エネ、電池使用時のみ省エネ、電源接続時のみ省エネから選べます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "왼쪽 버튼에는 현재 전략의 짧은 이름이 나옵니다. 열면 성능, 절전, 배터리일 때만 절전, 전원 연결 시만 절전 중에서 고릅니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O botão da esquerda mostra o nome curto da regra atual. Abra para escolher Desempenho, Economia de energia, Economia só na bateria ou Economia só na tomada." } },
        "ru": { "stringUnit": { "state": "translated", "value": "На левой кнопке короткое имя текущего плана. Откройте её, чтобы выбрать Производительность, Энергосбережение, Экономия только от батареи или Экономия только от сети." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "左边按钮上是当前策略的短名。点开可以选择性能、节能、仅使用电池时节能、仅接通电源时节能。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "左邊按鈕上是目前策略的短名。點開可以選擇效能、節能、僅使用電池時節能、僅接通電源時節能。" } }
      }
    },
    "tutorial.lowPower.now": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Taste zeigt, ob das Sparen gerade an ist. Ein Klick schaltet es um. Ein gelbes Symbol bedeutet, dass es an ist." } },
        "en": { "stringUnit": { "state": "translated", "value": "This button shows whether saving is on right now. Click it to toggle. A yellow icon means it is on." } },
        "es": { "stringUnit": { "state": "translated", "value": "Este botón indica si el ahorro está activo ahora. Un clic lo enciende o apaga. El icono amarillo significa que está activo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ce bouton indique si l’économie est active maintenant. Un clic la bascule. Une icône jaune signifie qu’elle est active." } },
        "it": { "stringUnit": { "state": "translated", "value": "Questo pulsante indica se il risparmio è attivo adesso. Un clic lo commuta. L’icona gialla significa che è attivo." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このボタンは、いま省エネがオンかを示します。点で切り替えます。アイコンが黄色ならオンです。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 버튼은 지금 절전이 켜져 있는지 보여 줍니다. 누르면 전환됩니다. 아이콘이 노란 색이면 켜진 상태입니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Este botão mostra se a economia está ligada agora. Um clique alterna. O ícone amarelo significa que está ligada." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Эта кнопка показывает, включено ли сбережение сейчас. Нажатие переключает его. Жёлтый значок значит, что оно включено." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这个按钮表示现在开没开节能。点一下就切换。图标是黄色时，表示已经打开。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這個按鈕表示現在開沒開節能。點一下就切換。圖示是黃色時，表示已經打開。" } }
      }
    },
    "tutorial.lowPower.buttons": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Es können beide Tasten erscheinen, nur die Regel oder nur Niedrig." } },
        "en": { "stringUnit": { "state": "translated", "value": "You can show both buttons, the rule only, or Low only." } },
        "es": { "stringUnit": { "state": "translated", "value": "Pueden aparecer los dos botones, solo la regla o solo Baja." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les deux boutons peuvent apparaître, ou seulement la règle, ou seulement Faible." } },
        "it": { "stringUnit": { "state": "translated", "value": "Possono comparire entrambi i pulsanti, solo la regola o solo Bassa." } },
        "ja": { "stringUnit": { "state": "translated", "value": "両方を出すか、方針だけ、低電力だけにできます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "둘 다 보이거나, 전략만, 또는 저전력만 보이게 할 수 있습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Os dois botões podem aparecer, só a regra ou só Baixa." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Можно показать обе кнопки, только план или только экономию." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "可以两个都出现，也可以只留策略，或只留低电量。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "可以兩個都出現，也可以只留策略，或只留低電量。" } }
      }
    },
    "tutorial.lowPower.layout": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Wenn beide Tasten sichtbar sind, stehen sie nebeneinander, sobald die Länge reicht, oder immer einzeln untereinander. Bleibt nur eine Taste, lässt sich die Anordnung nicht ändern." } },
        "en": { "stringUnit": { "state": "translated", "value": "When both buttons are shown, they sit side by side once the length fits, or each one always takes its own row. With only one button, Layout cannot be changed." } },
        "es": { "stringUnit": { "state": "translated", "value": "Si aparecen los dos, se ponen en la misma fila cuando la longitud lo permite, o cada uno en su fila. Si solo queda un botón, Disposición no se puede cambiar." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Quand les deux boutons sont visibles, ils se placent côte à côte si la longueur le permet, ou chacun sur sa ligne. S’il n’en reste qu’un, Disposition ne se règle pas." } },
        "it": { "stringUnit": { "state": "translated", "value": "Se compaiono entrambi, stanno sulla stessa riga quando la lunghezza lo consente, oppure ognuno sulla propria. Se ne resta uno solo, Disposizione non si può cambiare." } },
        "ja": { "stringUnit": { "state": "translated", "value": "両方出すときは、長さが足りれば横に並べるか、常に一つずつ縦に並べます。ボタンが一つのときは、並びは変更できません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "둘 다 보일 때는 길이가 되면 한 줄에 두거나, 항상 하나씩 한 줄에 둡니다. 버튼이 하나뿐이면 배치는 바꿀 수 없습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Quando os dois aparecem, ficam na mesma linha se o comprimento permitir, ou cada um na sua. Com um só botão, Disposição não pode ser alterada." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Когда видны обе кнопки, они стоят в один ряд, если длина позволяет, или каждая всегда на своей строке. Если кнопка одна, Расположение нельзя изменить." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "两个都出现时，可以在长度够的时候并排，也可以永远各占一行。只留一个按钮时，排列不能改。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "兩個都出現時，可以在長度夠的時候並排，也可以永遠各占一行。只留一個按鈕時，排列不能改。" } }
      }
    },
    "tutorial.lowPower.body": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Öffne Modus in der Seitenleiste. Die linke Taste zeigt den Namen der aktuellen Regel und öffnet das Menü. Niedrig zeigt, ob das Sparen gerade an ist, und schaltet es um. Tasten kann Beide, Nur Regel oder Nur Niedrig sein. Anordnung ist Zwei in einer Zeile, wenn die Länge reicht oder Immer eines pro Zeile. Bleibt nur eine Taste, lässt sich die Anordnung nicht ändern." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open Power in the sidebar. The left button shows the current rule’s name and opens the rule menu. Low shows whether saving is on right now and toggles it. Buttons can be Both, Rule only, or Low only. Layout is Two per row when the length fits or Always one per row. With only one button shown, Layout cannot be changed." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre Modo en la barra lateral. El botón de la izquierda muestra el nombre de la regla actual y abre el menú. Baja indica si el ahorro está activo ahora y lo enciende o apaga. Botones puede ser Ambos, Solo regla o Solo baja. Disposición es Dos en una fila si la longitud lo permite o Siempre uno por fila. Si solo queda un botón, Disposición no se puede cambiar." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvre Mode dans la barre latérale. Le bouton de gauche montre le nom de la règle en cours et ouvre le menu. Faible indique si l’économie est active maintenant et la bascule. Boutons peut être Les deux, Règle seule ou Faible seul. Disposition est Deux par ligne si la longueur le permet ou Toujours un par ligne. S’il ne reste qu’un bouton, Disposition ne se règle pas." } },
        "it": { "stringUnit": { "state": "translated", "value": "Apri Modo nella barra laterale. Il pulsante a sinistra mostra il nome della regola attuale e apre il menu. Bassa indica se il risparmio è attivo adesso e lo commuta. Pulsanti può essere Entrambi, Solo regola o Solo bassa. Disposizione è Due per riga se la lunghezza lo consente o Sempre uno per riga. Se resta un solo pulsante, Disposizione non si può cambiare." } },
        "ja": { "stringUnit": { "state": "translated", "value": "サイドバーの「省エネ」を開きます。左のボタンは現在の方針の名前を示し、方針のメニューを開きます。「低電力」はいま省エネ中かどうかを示し、点でオンとオフを切り替えます。ボタンは両方、方針のみ、低電力のみから選べます。並びは「長さが足りれば二つを一行」か「常に一つを一行」です。ボタンが一つだけのとき、並びは変更できません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "사이드바에서 절전을 엽니다. 왼쪽 버튼은 현재 전략 이름을 보여주고 전략 메뉴를 엽니다. 저전력은 지금 절전 중인지 보여 주고, 누르면 켜거나 끕니다. 버튼은 둘 다, 전략만, 저전력만 중에서 고릅니다. 배치는 길이가 되면 한 줄에 둘, 또는 항상 한 줄에 하나입니다. 버튼이 하나만 남으면 배치는 바꿀 수 없습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Abra Modo na barra lateral. O botão da esquerda mostra o nome da regra atual e abre o menu. Baixa mostra se a economia está ligada agora e a alterna. Botões pode ser Ambos, Só a regra ou Só baixa. Disposição é Dois por linha se o comprimento permitir ou Sempre um por linha. Com um só botão visível, Disposição não pode ser alterada." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте Режим на боковой панели. Левая кнопка показывает имя текущего плана и открывает меню. Экономия показывает, включено ли сбережение сейчас, и переключает его. Кнопки могут быть Оба, Только план или Только экономия. Расположение — Два в ряд, если длина позволяет или Всегда по одному в ряд. Когда видна только одна кнопка, Расположение нельзя изменить." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在侧边栏打开「能耗模式」。左边的按钮显示当前策略的名字，点开是策略菜单。右边的「低电量」表示现在开没开，点一下就切换。按钮可以是都出现、仅策略或仅低电量。排列在「长度允许下两个一行」和「永远一个一行」之间选；只留一个按钮时，排列不能改。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在側邊欄打開「能耗模式」。左邊的按鈕顯示目前策略的名字，點開是策略選單。右邊的「低電量」表示現在開沒開，點一下就切換。按鈕可以是都出現、僅策略或僅低電量。排列在「長度允許下兩個一行」和「永遠一個一行」之間選；只留一個按鈕時，排列不能改。" } }
      }
    },
    "tutorial.panel.body": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Öffne Bereiche in der Seitenleiste. Der Griff links zieht die Reihenfolge, der Schalter blendet den Bereich ein oder aus, und mindestens ein Bereich bleibt sichtbar. Standardmäßig liegt eine Linie zwischen je zwei eingeschalteten Bereichen; in der Reihenfolge kannst du eine Trennlinie ziehen, eine weitere hinzufügen oder eine entfernen. Pfeil, Position der Einstellungen-Schaltfläche (Eigener Block, In einem Block, Nur beim Rechtsklick) stehen auf derselben Seite." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open Panels in the sidebar. The grip on the left drags the order, each switch shows or hides that block, and at least one block stays on. By default there is a line between every two blocks that are on; in the panel order list you can drag a divider, add another, or remove one. The arrow and Settings button placement (its own block, inside a block, or only on right-click) are on this page too." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre Paneles en la barra lateral. El asa de la izquierda arrastra el orden, cada interruptor muestra u oculta ese bloque, y al menos un bloque sigue visible. De forma predeterminada hay una línea entre cada dos bloques activados; en la lista del orden puedes arrastrar un separador, añadir otro o quitar uno. La flecha y la ubicación del botón de ajustes (bloque propio, dentro de un bloque o solo al hacer clic derecho) están en esta misma página." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvre Panneaux dans la barre latérale. La poignée à gauche fait glisser l’ordre, chaque interrupteur affiche ou masque le bloc, et au moins un bloc reste visible. Par défaut, une ligne sépare chaque paire de blocs activés ; dans la liste d’ordre, tu peux faire glisser un séparateur, en ajouter un ou en retirer un. La flèche et l’emplacement du bouton Réglages (bloc séparé, dans un bloc, ou uniquement au clic droit) sont sur cette page." } },
        "it": { "stringUnit": { "state": "translated", "value": "Apri Pannelli nella barra laterale. La presa a sinistra trascina l’ordine, ogni interruttore mostra o nasconde il blocco, e almeno un blocco resta visibile. Per impostazione predefinita c’è una linea tra ogni due blocchi attivi; nell’elenco dell’ordine puoi trascinare un separatore, aggiungerne un altro o rimuoverne uno. La freccia e la posizione del pulsante Impostazioni (blocco dedicato, dentro un blocco, o solo con il clic destro) stanno in questa pagina." } },
        "ja": { "stringUnit": { "state": "translated", "value": "サイドバーの「パネル」を開きます。左のグリップで並べ替え、スイッチで出すかを決め、少なくとも一つは表示したままにします。初期状態ではオンのブロックのあいだに区切り線があり、順序リストで区切り線をドラッグ、追加、削除できます。矢印と、設定ボタンの位置（独立したブロック、既存のブロック内、右クリック時のみ）もこのページにあります。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "사이드바에서 패널을 엽니다. 왼쪽 손잡이로 순서를 끌고, 스위치로 블록을 켜거나 끄며, 최소한 한 블록은 켜 둡니다. 기본값은 켜진 블록 사이마다 구분선이 있고, 패널 순서 목록에서 구분선을 끌거나 추가하거나 지울 수 있습니다. 화살표와 설정 버튼 위치(별도의 블록, 기존 블록 안, 오른쪽 클릭 때만)도 이 페이지에 있습니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Abra Painéis na barra lateral. A alça à esquerda arrasta a ordem, cada interruptor mostra ou oculta o bloco, e pelo menos um bloco continua visível. Por padrão há uma linha entre cada dois blocos ligados; na lista de ordem você pode arrastar um divisor, adicionar outro ou remover um. A seta e a posição do botão de ajustes (bloco próprio, dentro de um bloco ou somente no clique direito) ficam nesta página." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте Панели на боковой панели. Ручка слева перетаскивает порядок, переключатель показывает или скрывает блок, и хотя бы один блок остаётся включённым. По умолчанию линия стоит между каждыми двумя включёнными блоками; в списке порядка разделитель можно перетащить, добавить ещё один или удалить. Стрелка и расположение кнопки настроек (отдельный блок, внутри блока или только по правому клику) тоже на этой странице." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在侧边栏打开「面板」。左边的握把用来拖动排序，开关决定这一块出不出现，至少要留一块开着。默认每两个打开的板块之间都有一条分割线；在面板顺序列表里可以拖动分割线，也可以再加一条或删掉。箭头和设置按钮出现位置也在这一页：可以单独一个区块、出现在某个区块里，或仅右键图标时出现。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在側邊欄打開「面板」。左邊的握把用來拖動排序，開關決定這一塊出不出現，至少要留一塊開著。預設每兩個打開的板塊之間都有一條分割線；在面板順序清單裡可以拖動分割線，也可以再加一條或刪掉。箭頭和設定按鈕出現位置也在這一頁：可以單獨一個區塊、出現在某個區塊裡，或僅右鍵圖示時出現。" } }
      }
    },
    "tutorial.localIP.body": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Öffne IP-Adresse in der Seitenleiste. Schalte die Bereiche ein, die du sehen willst: Lokal, Öffentlich, Loopback und Link-lokal. IPv4 und IPv6 lassen sich einzeln einschalten. Jede Zeile zeigt Bereich, Schnittstelle und Adresse. Schlägt die öffentliche Abfrage fehl, steht dort Nicht verfügbar." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open IP Address in the sidebar. Turn on the scopes you want: Local, Public, Loopback, and Link-local. IPv4 and IPv6 can each be turned on. Each row shows the scope, the interface name, and the address. If a public lookup fails, that row says Unavailable." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre Dirección IP en la barra lateral. Activa los rangos que quieras ver: Local, Pública, Bucle local y Enlace local. IPv4 e IPv6 se activan por separado. Cada fila muestra el rango, el nombre de la interfaz y la dirección. Si la consulta pública falla, esa fila dice No disponible." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvre Adresse IP dans la barre latérale. Active les plages à afficher : Locale, Publique, Boucle locale et Lien local. IPv4 et IPv6 s’activent séparément. Chaque ligne montre la plage, le nom de l’interface et l’adresse. Si la recherche publique échoue, la ligne indique Indisponible." } },
        "it": { "stringUnit": { "state": "translated", "value": "Apri Indirizzo IP nella barra laterale. Attiva gli intervalli da mostrare: Locale, Pubblico, Loopback e Link-local. IPv4 e IPv6 si attivano separatamente. Ogni riga mostra l’intervallo, il nome dell’interfaccia e l’indirizzo. Se la ricerca pubblica fallisce, la riga dice Non disponibile." } },
        "ja": { "stringUnit": { "state": "translated", "value": "サイドバーの「IP アドレス」を開きます。表示する範囲はローカル、パブリック、ループバック、リンクローカルから選びます。IPv4 と IPv6 もそれぞれ切り替えられます。パネルの各行は、範囲、インターフェース名、アドレスです。パブリックアドレスが取れないときは「取得できません」と出ます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "사이드바에서 IP 주소를 엽니다. 표시할 범위는 로컬, 공인, 루프백, 링크 로컬 중에서 고릅니다. IPv4와 IPv6도 각각 켤 수 있습니다. 패널의 각 줄은 범위, 인터페이스 이름, 주소입니다. 공인 주소를 가져오지 못하면 그 줄은 가져오지 못함으로 나옵니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Abra Endereço IP na barra lateral. Ative as faixas que quer ver: Local, Pública, Loopback e Link local. IPv4 e IPv6 podem ser ligados separadamente. Cada linha mostra a faixa, o nome da interface e o endereço. Se a consulta pública falhar, essa linha mostra Indisponível." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте IP-адрес на боковой панели. Включите нужные диапазоны: Локальный, Публичный, Петлевой и Канальный. IPv4 и IPv6 включаются по отдельности. Каждая строка показывает диапазон, имя интерфейса и адрес. Если публичный адрес не удалось получить, в строке будет Недоступно." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在侧边栏打开「IP 地址」。范围可以勾选本地、公网、回环和链路。IPv4 和 IPv6 也可以分别勾选。面板里每一行是范围、网卡名和地址。公网查不到时，这一行会写成「获取失败」。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在側邊欄打開「IP 位址」。範圍可以勾選本地、公網、迴環和鏈路。IPv4 和 IPv6 也可以分別勾選。面板裡每一行是範圍、網卡名和位址。公網查不到時，這一列會寫成「取得失敗」。" } }
      }
    },
    "tutorial.batteryCycle.body": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Öffne Zyklen in der Seitenleiste. Kapazität legt fest, ob die maximale Kapazität als Prozent, in mAh oder als Beides erscheint." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open Cycles in the sidebar. Capacity sets whether maximum capacity is written as Percent, as mAh, or as Both." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre Ciclos en la barra lateral. Capacidad decide si la capacidad máxima se escribe como Porcentaje, en mAh o como Ambos." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvre Cycles dans la barre latérale. Capacité décide si la capacité maximale s’écrit en Pourcentage, en mAh, ou Les deux." } },
        "it": { "stringUnit": { "state": "translated", "value": "Apri Cicli nella barra laterale. Capacità decide se la capacità massima compare come Percentuale, in mAh o come Entrambi." } },
        "ja": { "stringUnit": { "state": "translated", "value": "サイドバーの「サイクル」を開きます。容量は、最大容量をパーセント、mAh、または両方のどれで書くかを決めます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "사이드바에서 사이클을 엽니다. 용량은 최대 용량을 백분율, mAh, 또는 둘 다 중 무엇으로 쓸지 정합니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Abra Ciclos na barra lateral. Capacidade define se a capacidade máxima aparece como Porcentagem, em mAh ou como Ambos." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте Циклы на боковой панели. Ёмкость задаёт, как писать максимальную ёмкость: Проценты, мА·ч или Оба." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在侧边栏打开「电池循环」。容量格式决定最大容量写成百分比、mAh，或两个都要。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在側邊欄打開「電池循環」。容量格式決定最大容量寫成百分比、mAh，或兩個都要。" } }
      }
    },
