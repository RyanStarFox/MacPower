          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué MacPower usa Bluetooth"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que o MacPower usa Bluetooth"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché MacPower usa Bluetooth"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачем MacPower нужен Bluetooth"
          }
        }
      }
    },
    "settings.permissions.bluetooth.reason.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower asks for Bluetooth only to read battery levels from headphones and accessories you have already paired with this Mac. Those levels appear in the panel rings. It does not look for new nearby devices and does not play or record audio. After you continue, macOS will show its own permission dialog."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower 申请蓝牙，只是为了读取你已经和这台 Mac 配对过的耳机、配件的电量，好在面板圆环里显示。不会搜索附近的新设备，也不会播放或录制声音。点继续后，系统会再弹出它自己的权限对话框。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower 申請藍牙，只是為了讀取你已經和這台 Mac 配對過的耳機、配件的電量，好在面板圓環裡顯示。不會搜尋附近的新裝置，也不會播放或錄製聲音。點繼續後，系統會再彈出它自己的權限對話框。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower が Bluetooth を求めるのは、この Mac にすでにペアリングしたヘッドフォンなどの電池残量を読み、パネルのリングに出すためだけです。近くの新しい機器は探さず、音声の再生や録音もしません。続けると、macOS 自身の許可ダイアログが出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower가 Bluetooth를 요청하는 이유는 이미 이 Mac에 페어링된 헤드폰·액세서리의 배터리를 읽어 패널 링에 표시하기 위해서뿐입니다. 주변의 새 기기를 찾지 않으며 오디오를 재생하거나 녹음하지 않습니다. 계속하면 macOS 권한 대화상자가 나타납니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower demande Bluetooth uniquement pour lire la batterie des écouteurs déjà appairés à ce Mac, afin de l’afficher dans les anneaux. Pas de recherche à proximité, ni lecture/enregistrement audio. Ensuite, macOS affichera sa propre boîte de dialogue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower braucht Bluetooth nur, um den Akku bereits mit diesem Mac gekoppelter Kopfhörer für die Ringe im Panel zu lesen. Keine Suche in der Nähe, kein Audio. Danach zeigt macOS seinen eigenen Dialog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower pide Bluetooth solo para leer la batería de auriculares ya emparejados con este Mac y mostrarla en los anillos. No busca dispositivos cercanos ni reproduce/graba audio. Después macOS mostrará su propio diálogo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MacPower pede Bluetooth só para ler a bateria de fones já pareados com este Mac e mostrar nos anéis. Não procura aparelhos por perto nem toca/grava áudio. Em seguida o macOS mostra o próprio diálogo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower chiede Bluetooth solo per leggere la batteria delle cuffie già associate a questo Mac e mostrarla negli anelli. Non cerca dispositivi vicini né riproduce/registra audio. Poi macOS mostra la propria finestra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPower просит Bluetooth только чтобы читать заряд уже сопряжённых с этим Mac наушников для колец в панели. Не ищет устройства рядом и не воспроизводит/записывает звук. Дальше macOS покажет свой диалог."
          }
        }
      }
    },
