    "welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "MacPower sitzt in der Menüleiste, nicht im Dock. Schalte das Symbol ein, danach geht alles von dort aus." } },
