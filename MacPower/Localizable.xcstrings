    "settings.permissions.lowPower.caption.system": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac can already run pmset without a password (for example passwordless sudo for your account). Low Power Mode works; MacPower did not install its own rule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已经能无密码运行 pmset（例如账户开了免密 sudo）。节能模式本来就能用，MacPower 没有另装自己的规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 已經能無密碼執行 pmset（例如帳戶開了免密 sudo）。節能模式本來就能用，MacPower 沒有另裝自己的規則。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac はすでにパスワードなしで pmset を実行できます（例: アカウントの NOPASSWD sudo）。低電力モードはそのままで使え、MacPower 独自のルールは入れていません。"
          }
