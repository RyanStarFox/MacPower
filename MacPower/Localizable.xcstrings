    "popover.lowPower.override": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Zustand weicht vom Standard ab. Beim Wechsel der Stromquelle gilt wieder der Standard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current state differs from the default. The default is reapplied when the power source changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado actual difiere del predeterminado. Se volverá a aplicar al cambiar la fuente de alimentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état actuel diffère de l’état par défaut. Celui-ci sera réappliqué au changement d’alimentation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato attuale è diverso da quello predefinito, che verrà riapplicato al cambio di alimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の状態はデフォルトと異なります。電源が切り替わるとデフォルトの状態に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 상태가 기본 상태와 다릅니다. 전원이 바뀌면 기본 상태가 다시 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado atual difere do padrão. O padrão será reaplicado quando a fonte de energia mudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущее состояние отличается от заданного по умолчанию. При смене источника питания настройки по умолчанию будут применены снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前状态与默认状态不同，切换电源后会恢复默认状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前狀態與預設狀態不同，切換電源後會恢復預設狀態。"
          }
        }
      }
    },
