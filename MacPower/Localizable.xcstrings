        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前版本是 %@。開啟 GitHub 發佈頁即可下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョンは %@ です。GitHub のリリースページを開いてダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 버전은 %@입니다. GitHub 릴리스 페이지에서 다운로드하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez %@. Ouvrez la page GitHub des versions pour le télécharger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %@. Öffnen Sie die GitHub-Releaseseite zum Download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %@. Abre la página de GitHub para descargarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem %@. Abra a página de versões no GitHub para baixar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai %@. Apri la pagina GitHub delle versioni per scaricarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
