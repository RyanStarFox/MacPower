    "settings.icons.builtinEditNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in presets cannot be overwritten. Use Save As to create a custom copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统预设不能覆盖，请使用「另存为」创建自定义副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建預設無法覆寫，請使用「另存新檔」建立自訂副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵プリセットは上書きできません。「名前を付けて保存」でカスタムコピーを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 제공 프리셋은 덮어쓸 수 없습니다. 다른 이름으로 저장하여 사용자 지정 사본을 만드세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préréglages intégrés ne peuvent pas être écrasés. Utilisez Enregistrer sous pour créer une copie personnalisée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingebaute Presets können nicht überschrieben werden. Speichern Sie unter einem neuen Namen eine eigene Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes integrados no se pueden sobrescribir. Usa Guardar como para crear una copia personalizada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinições integradas não podem ser substituídas. Use Salvar como para criar uma cópia personalizada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I predefiniti integrati non possono essere sovrascritti. Usa Salva con nome per creare una copia personalizzata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные пресеты нельзя перезаписать. Используйте «Сохранить как», чтобы создать свою копию."
          }
        }
      }
    },
