    "update.available.message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %@. Open the GitHub release page to download it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本是 %@。打开 GitHub 发布页即可下载。"
