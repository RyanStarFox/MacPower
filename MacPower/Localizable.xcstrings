    "settings.flow.presetOrder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bars from left to right: Charging, On battery, Adapter hold, Underpowered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色条从左到右依次是：充电中、使用电池、电源维持、功率不足。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色條從左到右依次是：充電中、使用電池、電源維持、功率不足。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーは左から順に、充電中、バッテリー使用、電源維持、電力不足です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막대는 왼쪽부터 충전 중, 배터리 사용, 전원 유지, 전력 부족입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barres de gauche à droite : en charge, sur batterie, maintien secteur, puissance insuffisante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Balken von links nach rechts: Lädt, Akku, Netzteil hält, Zu wenig Leistung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barras de izquierda a derecha: cargando, con batería, mantenimiento, potencia insuficiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Barras da esquerda para a direita: carregando, na bateria, manutenção, potência insuficiente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre da sinistra a destra: in carica, a batteria, mantenimento, potenza insufficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полосы слева направо: зарядка, от батареи, удержание, недостаток мощности."
          }
        }
      }
    },
