    "settings.localIP.families.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4 is the familiar four numbers; IPv6 is longer, with colons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4 是常见的四段数字；IPv6 更长，带冒号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4 是常見的四段數字；IPv6 較長，帶冒號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4 はおなじみの4つの数字、IPv6 はコロンを含む長い形式です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4는 익숙한 네 개의 숫자이고, IPv6는 콜론이 있는 더 긴 형식입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4 : les quatre nombres habituels ; IPv6 : plus long, avec des deux-points."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4 sind die bekannten vier Zahlen, IPv6 ist länger und enthält Doppelpunkte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4 son los cuatro números habituales; IPv6 es más largo y lleva dos puntos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4 são os quatro números conhecidos; IPv6 é mais longo, com dois-pontos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4 sono i soliti quattro numeri; IPv6 è più lungo, con i due punti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4 — привычные четыре числа; IPv6 длиннее и содержит двоеточия."
          }
        }
      }
    },
