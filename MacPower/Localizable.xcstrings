        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論放在哪裡，右鍵點按選單列圖示都能打開設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこに置いても、メニューバーのアイコンを右クリックすれば設定を開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디에 두든 메뉴 막대 아이콘을 오른쪽 클릭하면 설정을 열 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où qu’il soit, un clic droit sur l’icône de la barre des menus ouvre toujours les réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo auch immer sie ist: Ein Rechtsklick auf das Menüleistensymbol öffnet immer die Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esté donde esté, al hacer clic derecho en el icono de la barra de menús siempre se abre la configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde quer que esteja, clicar com o botão direito no ícone da barra de menus sempre abre os Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovunque si trovi, un clic destro sull’icona nella barra dei menu apre sempre le impostazioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где бы она ни была, правый щелчок по значку в строке меню всегда открывает настройки."
          }
        }
      }
    },
