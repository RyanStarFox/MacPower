    "settings.icons.builtinEditNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in presets cannot be overwritten. Use Save As to create a custom copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统预设不能覆盖，请使用「另存为」创建自定义副本。"
