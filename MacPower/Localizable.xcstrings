    "settings.localIP.scope.local.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Addresses on your local network, such as 192.168.x.x."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网里的地址，比如 192.168.x.x。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域網路裡的位址，例如 192.168.x.x。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワーク上のアドレス（192.168.x.x など）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
