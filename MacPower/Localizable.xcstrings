        "en": { "stringUnit": { "state": "translated", "value": "Remove the row break" } },
        "es": { "stringUnit": { "state": "translated", "value": "Quitar el salto de fila" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Retirer le saut de ligne" } },
        "it": { "stringUnit": { "state": "translated", "value": "Rimuovere l’interruzione di riga" } },
        "ja": { "stringUnit": { "state": "translated", "value": "改行をやめる" } },
        "ko": { "stringUnit": { "state": "translated", "value": "줄바꿈 없애기" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Remover a quebra de linha" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Убрать перенос строки" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "取消换行" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "取消換行" } }
      }
