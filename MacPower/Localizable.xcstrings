    "settings.topApps.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy impact uses the same method as Activity Monitor, but over a different window and refresh time, so the numbers are close rather than identical."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「对能耗的影响」和活动监视器用的是同一套算法，但两边的统计时段和刷新时间不同，所以数字接近而不会完全一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「對能耗的影響」和活動監視器用的是同一套演算法，但兩邊的統計時段和更新時間不同，所以數字接近而不會完全一樣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「エネルギー影響」はアクティビティモニタと同じ方法ですが、集計期間と更新時間が異なるため、数値は近くても完全には一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘에너지 영향’은 활성 상태 보기와 같은 방법이지만 집계 기간과 새로 고침 시간이 달라, 숫자가 비슷하되 똑같지는 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impact énergétique suit la même méthode que le Moniteur d’activité, mais sur une autre période et un autre rythme d’actualisation : les chiffres sont proches sans être identiques."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Energiewirkung nutzt dieselbe Methode wie die Aktivitätsanzeige, aber mit anderem Zeitraum und anderer Aktualisierung, daher sind die Zahlen ähnlich, aber nicht gleich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El impacto energético usa el mismo método que el Monitor de Actividad, pero con otro intervalo y otra frecuencia de actualización, así que las cifras se parecen sin ser idénticas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O impacto energético usa o mesmo método do Monitor de Atividade, mas com outro período e outra atualização, então os números ficam próximos, não idênticos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impatto energetico usa lo stesso metodo di Monitoraggio Attività, ma con un altro intervallo e un altro aggiornamento, quindi i numeri sono vicini ma non identici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Влияние на энергию» считается так же, как в Мониторинге системы, но за другой период и с другим обновлением, поэтому числа близки, но не совпадают."
          }
        }
      }
    },
