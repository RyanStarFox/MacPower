          "stringUnit": {
            "state": "translated",
            "value": "Cette taille remplit l’anneau à moitié. Un anneau plein correspond toujours à toute la mémoire. La valeur d’origine est un quart de cette mémoire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Größe füllt den Ring zur Hälfte. Ein voller Ring ist immer der gesamte Arbeitsspeicher. Voreingestellt ist ein Viertel davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tamaño llena el anillo hasta la mitad. El anillo lleno es siempre toda la memoria. El valor inicial es un cuarto de esa memoria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tamanho enche o anel até a metade. O anel cheio é sempre toda a memória. O padrão é um quarto dessa memória."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa dimensione riempie l’anello a metà. L’anello pieno è sempre tutta la memoria. Il valore iniziale è un quarto di quella memoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот размер заполняет кольцо наполовину. Полное кольцо — это всегда вся память. По умолчанию это её четверть."
          }
        }
      }
    },
